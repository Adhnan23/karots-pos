package aicatalog

import "karots-pos/templates/layouts"

type PageData struct {
	UserName       string
	Provider       string
	BaseURL        string
	Model          string
	HasKey         bool
	DefaultMarkup  string
	ManualMode     bool
	HasLastRun     bool
	LastRunSummary string
}

type OptimizeData struct {
	Plan       OptimizePlan
	CatName    map[int64]string
	ProdName   map[int64]string
	PlanJSON   string
	HasChanges bool
}

templ Page(d PageData) {
	@layouts.Admin("AI Catalog", d.UserName, "aicatalog") {
		<div class="max-w-2xl mx-auto">
			<h1 class="text-2xl font-bold mb-1">AI Catalog — add products fast</h1>
			<p class="text-sm text-slate-500 mb-4">Type a name or code; the AI names it, suggests a category, and walks you through one step at a time.</p>
			<details class="bg-white rounded-2xl shadow-sm p-4 mb-6">
				<summary class="cursor-pointer text-sm font-medium">AI settings</summary>
				<form method="post" action="/admin/ai-catalog/settings" class="mt-4 grid gap-3" x-data={ "{manual:" + jsBool(d.ManualMode) + "}" }>
					<label class="flex items-start gap-2 rounded-lg bg-slate-50 px-3 py-2">
						<input type="checkbox" name="manual_mode" checked?={ d.ManualMode } x-model="manual" class="mt-0.5"/>
						<span class="text-sm">
							<span class="font-medium">Manual mode — no API key</span>
							<span class="block text-xs text-slate-500">Don't have a paid AI key? Turn this on and the plugin gives you a prompt to paste into any chatbot (ChatGPT, Gemini, Claude — where web search is free), then you paste the answer back.</span>
						</span>
					</label>
					<div x-show="!manual" class="grid gap-3">
					<label class="text-xs text-slate-500">Preset (fills the fields below — then just paste your key)
						<select onchange="aiApplyPreset(this)" class="mt-1 w-full border rounded-lg px-3 py-1.5">
							<option value="">— choose a provider —</option>
							<option value="gemini" data-provider="gemini" data-base="https://generativelanguage.googleapis.com/v1beta/openai" data-model="gemini-2.5-flash">Google Gemini (free tier, can web-search)</option>
							<option value="openrouter" data-provider="openrouter" data-base="https://openrouter.ai/api/v1" data-model="google/gemini-2.0-flash-exp:free">OpenRouter (free models)</option>
							<option value="groq" data-provider="groq" data-base="https://api.groq.com/openai/v1" data-model="openai/gpt-oss-120b">Groq (fast free tier)</option>
							<option value="openai" data-provider="openai" data-base="https://api.openai.com/v1" data-model="gpt-4o-mini">OpenAI (paid)</option>
							<option value="ollama" data-provider="ollama" data-base="http://localhost:11434/v1" data-model="">Ollama (local — no key)</option>
							<option value="lmstudio" data-provider="lmstudio" data-base="http://localhost:1234/v1" data-model="">LM Studio (local — no key)</option>
							<option value="llamacpp" data-provider="llamacpp" data-base="http://localhost:8080/v1" data-model="">llama.cpp server (local — no key)</option>
						</select>
					</label>
					<p class="text-xs text-slate-400 -mt-1">Local providers (Ollama / LM Studio / llama.cpp) need no key — leave it blank. Any OpenAI-compatible base URL works.</p>
					<label class="text-xs text-slate-500">Provider
						<input id="ai-provider" name="provider" value={ d.Provider } class="mt-1 w-full border rounded-lg px-3 py-1.5"/>
					</label>
					<label class="text-xs text-slate-500">Base URL
						<input id="ai-base" name="base_url" value={ d.BaseURL } class="mt-1 w-full border rounded-lg px-3 py-1.5"/>
					</label>
					<label class="text-xs text-slate-500">Model
						<div class="mt-1 flex gap-2">
							<input id="ai-model" name="model" value={ d.Model } list="ai-model-list" placeholder="pick or type a model" class="w-full border rounded-lg px-3 py-1.5"/>
							<button type="button" hx-post="/admin/ai-catalog/models"
								hx-include="[name='provider'],[name='base_url'],[name='api_key']"
								hx-target="#ai-models" hx-swap="innerHTML"
								class="shrink-0 px-3 py-1.5 rounded-lg border text-sm">Load models</button>
						</div>
						<div id="ai-models" class="mt-1"></div>
					</label>
					<label class="text-xs text-slate-500">API key
						if d.HasKey {
							<input name="api_key" type="password" placeholder="•••• saved (leave blank to keep)" class="mt-1 w-full border rounded-lg px-3 py-1.5"/>
						} else {
							<input name="api_key" type="password" placeholder="paste your key" class="mt-1 w-full border rounded-lg px-3 py-1.5"/>
						}
					</label>
					</div>
					<label class="text-xs text-slate-500">Default markup (selling ÷ this = cost)
						<input name="default_markup" value={ d.DefaultMarkup } class="mt-1 w-32 border rounded-lg px-3 py-1.5"/>
					</label>
					<div class="flex gap-2">
						<button class="px-4 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium">Save</button>
						<button type="button" x-show="!manual" hx-post="/admin/ai-catalog/test-key" class="px-4 py-1.5 rounded-lg border text-sm">Test AI</button>
					</div>
				</form>
			</details>
			<div id="ai-step" class="bg-white rounded-2xl shadow-sm p-6">
				@StepIdentify()
			</div>
			<div class="mt-6 bg-white rounded-2xl shadow-sm p-6">
				<div class="flex items-center justify-between gap-3 flex-wrap">
					<div>
						<h2 class="text-lg font-semibold">🧹 Optimize categories</h2>
						<p class="text-sm text-slate-500">Let the AI tidy the category tree — merge duplicates, group loose categories, and re-file mis-placed products. You review before it applies, and you can revert.</p>
					</div>
					<div class="flex gap-2">
						<button hx-get="/admin/ai-catalog/optimize" hx-target="#ai-optimize" hx-swap="innerHTML"
							hx-indicator="#ai-opt-spin"
							class="px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium">Scan &amp; suggest</button>
						if d.HasLastRun {
							<button hx-post="/admin/ai-catalog/optimize/revert" hx-target="#ai-optimize" hx-swap="innerHTML"
								hx-confirm="Revert the last optimize? This restores the previous category tree."
								class="px-4 py-2 rounded-lg border text-sm">↩ Revert last ({ d.LastRunSummary })</button>
						}
					</div>
				</div>
				<div id="ai-opt-spin" class="htmx-indicator text-sm text-slate-400 mt-3">Thinking…</div>
				<div id="ai-optimize" class="mt-4"></div>
			</div>
		</div>
		<script>
			function aiCopyPrompt(btn) {
				var ta = btn.closest('.ai-copybox').querySelector('textarea');
				ta.select();
				navigator.clipboard && navigator.clipboard.writeText(ta.value);
				var old = btn.textContent; btn.textContent = 'Copied ✓';
				setTimeout(function () { btn.textContent = old; }, 1500);
			}
			function aiApplyPreset(sel) {
				var o = sel.options[sel.selectedIndex];
				if (!o || !o.dataset.base) return;
				document.getElementById('ai-provider').value = o.dataset.provider || '';
				document.getElementById('ai-base').value = o.dataset.base || '';
				document.getElementById('ai-model').value = o.dataset.model || '';
			}
			document.body.addEventListener('ai-print-labels', function (e) {
				var d = e.detail || {};
				var body = new URLSearchParams({ product_id: d.product_id, qty: d.qty, slots: '0', show_price: '1' });
				fetch('/admin/labels/send', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body });
			});
		</script>
	}
}

// hidden carries all accumulated wizard state forward. Each editing step uses a
// DISTINCT visible input name (e.g. category_in) so it never collides with the
// hidden field it will become on the next step.
templ hidden(w wizard) {
	<input type="hidden" name="query" value={ w.Query }/>
	<input type="hidden" name="name" value={ w.Name }/>
	<input type="hidden" name="category" value={ w.Category }/>
	<input type="hidden" name="specs" value={ w.Specs }/>
	<input type="hidden" name="explanation" value={ w.Explanation }/>
	<input type="hidden" name="source" value={ w.Source }/>
	<input type="hidden" name="barcode" value={ w.Barcode }/>
	<input type="hidden" name="cost_price" value={ w.CostPrice }/>
	<input type="hidden" name="selling_price" value={ w.Selling }/>
	<input type="hidden" name="qty" value={ w.Qty }/>
	if len(w.Queue) > 0 {
		<input type="hidden" name="queue" value={ joinQueue(w.Queue) }/>
	}
	if w.BulkTotal > 0 {
		<input type="hidden" name="bulk_total" value={ itoa(w.BulkTotal) }/>
	}
}

// bulkProgress shows "Product X of Y" while stepping through a multi-item batch.
templ bulkProgress(w wizard) {
	if w.BulkTotal > 1 {
		<div class="mb-2 inline-block rounded bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700">
			Product { itoa(w.BulkTotal - len(w.Queue)) } of { itoa(w.BulkTotal) }
		</div>
	}
}

templ stepHeader(step, total int, title string) {
	<div class="mb-3 flex items-center gap-2">
		<span class="text-xs font-semibold text-indigo-600">Step { itoa(step) }/{ itoa(total) }</span>
		<h2 class="text-lg font-semibold">{ title }</h2>
	</div>
}

// ModelOptions fills the model combo box's datalist from a live provider fetch.
templ ModelOptions(models []string, errMsg string) {
	<datalist id="ai-model-list">
		for _, m := range models {
			<option value={ m }></option>
		}
	</datalist>
	if errMsg != "" {
		<span class="text-xs text-rose-600">Couldn't load models: { errMsg }</span>
	} else if len(models) > 0 {
		<span class="text-xs text-emerald-600">{ itoa(len(models)) } models loaded — click the box to pick.</span>
	} else {
		<span class="text-xs text-slate-400">No models returned.</span>
	}
}

templ OptimizeError(msg string) {
	<p class="text-sm text-rose-600">Couldn't get suggestions: { msg }</p>
}

templ OptimizeResult(msg string, applied bool) {
	<div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
		{ msg }
		if applied {
			<span class="text-slate-500"> — reload the page to see the updated tree; use “Revert last” if you don't like it.</span>
		}
	</div>
}

templ OptimizePreview(d OptimizeData) {
	if !d.HasChanges {
		<p class="text-slate-500">Catalog looks tidy — nothing to optimize. 🎉</p>
	} else {
		<div class="space-y-4 text-sm">
			if len(d.Plan.Merges) > 0 {
				<div>
					<h3 class="font-semibold text-slate-700 mb-1">Merge duplicates</h3>
					<ul class="space-y-1">
						for _, op := range d.Plan.Merges {
							<li>Merge <span class="font-medium">{ catLabel(d.CatName, op.From) }</span> → <span class="font-medium">{ catLabel(d.CatName, op.Into) }</span> <span class="text-slate-400">{ op.Reason }</span></li>
						}
					</ul>
				</div>
			}
			if len(d.Plan.Reparents) > 0 {
				<div>
					<h3 class="font-semibold text-slate-700 mb-1">Group under a parent</h3>
					<ul class="space-y-1">
						for _, op := range d.Plan.Reparents {
							<li>Move <span class="font-medium">{ catLabel(d.CatName, op.ID) }</span> under <span class="font-medium">{ catLabel(d.CatName, op.ParentID) }</span> <span class="text-slate-400">{ op.Reason }</span></li>
						}
					</ul>
				</div>
			}
			if len(d.Plan.Renames) > 0 {
				<div>
					<h3 class="font-semibold text-slate-700 mb-1">Rename</h3>
					<ul class="space-y-1">
						for _, op := range d.Plan.Renames {
							<li><span class="font-medium">{ catLabel(d.CatName, op.ID) }</span> → <span class="font-medium">{ op.To }</span> <span class="text-slate-400">{ op.Reason }</span></li>
						}
					</ul>
				</div>
			}
			if len(d.Plan.Moves) > 0 {
				<div>
					<h3 class="font-semibold text-slate-700 mb-1">Re-file products</h3>
					<ul class="space-y-1">
						for _, op := range d.Plan.Moves {
							<li>Move <span class="font-medium">{ nameOr(d.ProdName, op.ProductID) }</span> → <span class="font-medium">{ catLabel(d.CatName, op.CategoryID) }</span> <span class="text-slate-400">{ op.Reason }</span></li>
						}
					</ul>
				</div>
			}
			<form hx-post="/admin/ai-catalog/optimize/apply" hx-target="#ai-optimize" hx-swap="innerHTML">
				<input type="hidden" name="plan" value={ d.PlanJSON }/>
				<button class="mt-2 px-5 py-2 rounded-lg bg-emerald-600 text-white font-semibold">✓ Apply all changes</button>
				<span class="ml-2 text-xs text-slate-400">You can revert this afterward.</span>
			</form>
		</div>
	}
}

// manualCopyBox shows a read-only prompt with a Copy button (bring-your-own-chatbot mode).
templ manualCopyBox(prompt string) {
	<div class="ai-copybox">
		<div class="flex items-center justify-between mb-1">
			<span class="text-xs font-medium text-slate-500">Prompt — paste this into your chatbot</span>
			<button type="button" onclick="aiCopyPrompt(this)" class="px-3 py-1 rounded-lg border text-xs">Copy prompt</button>
		</div>
		<textarea readonly rows="6" class="w-full border rounded-lg px-3 py-2 text-xs font-mono bg-slate-50">{ prompt }</textarea>
	</div>
}

templ StepManualIdentify(w wizard, prompt, errMsg string) {
	@stepHeader(2, 6, "Ask your chatbot")
	@bulkProgress(w)
	<p class="text-sm text-slate-500 mb-3">Copy this, paste it into ChatGPT / Gemini / Claude (turn on web search if it has it), then paste the reply back below.</p>
	@manualCopyBox(prompt)
	if errMsg != "" {
		<p class="text-sm text-rose-600 mt-3">{ errMsg }</p>
	}
	<form hx-post="/admin/ai-catalog/identify/manual" hx-target="#ai-step" hx-swap="innerHTML" class="mt-4">
		@hidden(w)
		<label class="block text-sm text-slate-500 mb-1">Paste the chatbot's answer</label>
		<textarea name="response" rows="6" autofocus placeholder="paste the reply here…" class="w-full border rounded-lg px-3 py-2 text-sm font-mono"></textarea>
		<button class="mt-3 px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Continue →</button>
	</form>
}

templ OptimizeManualPrompt(prompt, errMsg string) {
	<p class="text-sm text-slate-500 mb-3">Manual mode: copy this into your chatbot, then paste its reply back to preview the changes.</p>
	@manualCopyBox(prompt)
	if errMsg != "" {
		<p class="text-sm text-rose-600 mt-3">{ errMsg }</p>
	}
	<form hx-post="/admin/ai-catalog/optimize/manual" hx-target="#ai-optimize" hx-swap="innerHTML" class="mt-4">
		<label class="block text-sm text-slate-500 mb-1">Paste the chatbot's answer</label>
		<textarea name="response" rows="6" placeholder="paste the reply here…" class="w-full border rounded-lg px-3 py-2 text-sm font-mono"></textarea>
		<button class="mt-3 px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Preview changes →</button>
	</form>
}

templ StepIdentify() {
	@stepHeader(1, 6, "Add a product")
	<form hx-post="/admin/ai-catalog/identify" hx-target="#ai-step" hx-swap="innerHTML">
		<label class="block text-sm text-slate-500 mb-2">Product name, code, or part number</label>
		<input name="query" autofocus placeholder="e.g. 6200 2RS · Coca-Cola 500ml · A4 paper" class="w-full border rounded-lg px-3 py-2 text-lg"/>
		<button class="mt-3 px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Identify →</button>
		<details class="mt-4">
			<summary class="cursor-pointer text-sm text-slate-500">➕ Add several at once</summary>
			<label class="mt-2 mb-1 block text-xs text-slate-500">One item per line (or comma-separated) — the assistant walks you through each in turn.</label>
			<textarea name="queries" rows="4" placeholder="one item per line…" class="w-full border rounded-lg px-3 py-2"></textarea>
			<button class="mt-2 px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Start with these →</button>
		</details>
	</form>
}

templ StepIdentifyError(msg string) {
	@stepHeader(1, 6, "Add a product")
	<p class="text-sm text-rose-600 mb-2">{ msg }</p>
	<form hx-post="/admin/ai-catalog/identify" hx-target="#ai-step" hx-swap="innerHTML">
		<input name="query" autofocus placeholder="e.g. 6200 2RS · Coca-Cola 500ml · A4 paper" class="w-full border rounded-lg px-3 py-2 text-lg"/>
		<button class="mt-3 px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Identify →</button>
	</form>
}

templ StepOptions(w wizard) {
	@stepHeader(2, 6, "Which one is it?")
	@bulkProgress(w)
	if w.AIError != "" {
		<p class="text-sm text-amber-700 bg-amber-50 rounded-lg px-3 py-2 mb-3">AI couldn't help ({ w.AIError }). Pick a manual option below.</p>
	}
	<div class="grid gap-2">
		for _, opt := range w.Options {
			<form hx-post="/admin/ai-catalog/pick" hx-target="#ai-step" hx-swap="innerHTML">
				<input type="hidden" name="query" value={ w.Query }/>
				<input type="hidden" name="name" value={ opt.Name }/>
				<input type="hidden" name="category" value={ opt.Category }/>
				<input type="hidden" name="specs" value={ opt.Specs }/>
				<input type="hidden" name="explanation" value={ opt.Explanation }/>
				if w.Confident {
					<input type="hidden" name="confident" value="1"/>
				}
				<button class="w-full text-left border rounded-xl px-4 py-3 hover:border-indigo-500 hover:bg-indigo-50 transition">
					<div class="flex items-center justify-between">
						<span class="font-medium">{ opt.Name }</span>
						if w.Confident {
							<span class="text-xs px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-700">Best match</span>
						}
					</div>
					if opt.Explanation != "" {
						<div class="text-sm text-slate-500 mt-0.5">{ opt.Explanation }</div>
					}
					if opt.Category != "" {
						<div class="text-xs text-slate-400 mt-1">→ { opt.Category }</div>
					}
				</button>
			</form>
		}
	</div>
	<form hx-post="/admin/ai-catalog/pick" hx-target="#ai-step" hx-swap="innerHTML" class="mt-4 border-t pt-4">
		<input type="hidden" name="query" value={ w.Query }/>
		<label class="block text-sm text-slate-500 mb-1">None of these — tell it what this is</label>
		<div class="flex gap-2">
			<input name="explain" placeholder="e.g. small sealed bearing for a fan motor" class="flex-1 border rounded-lg px-3 py-2"/>
			<button class="px-4 py-2 rounded-lg bg-slate-700 text-white text-sm">Use this →</button>
		</div>
	</form>
}

templ StepCategory(w wizard) {
	@stepHeader(3, 6, "Name & category")
	@bulkProgress(w)
	<form hx-post="/admin/ai-catalog/category" hx-target="#ai-step" hx-swap="innerHTML">
		@hidden(w)
		<label class="block text-sm text-slate-500 mb-1">Product name (AI suggestion — edit if needed)</label>
		<input name="name_in" value={ w.Name } autofocus class="w-full border rounded-lg px-3 py-2 mb-3"/>
		<label class="block text-sm text-slate-500 mb-1">Category path — use &gt; for sub-categories (edit if needed)</label>
		<input name="category_in" value={ w.Category } placeholder="e.g. Bearings > Deep Groove" class="w-full border rounded-lg px-3 py-2"/>
		<button class="mt-3 px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Next: barcode →</button>
	</form>
}

templ StepBarcode(w wizard) {
	@stepHeader(4, 6, "Barcode")
	@bulkProgress(w)
	if w.Warn != "" {
		<p class="text-sm text-rose-600 mb-2">{ w.Warn }</p>
	}
	<form hx-post="/admin/ai-catalog/barcode" hx-target="#ai-step" hx-swap="innerHTML">
		@hidden(w)
		<label class="block text-sm text-slate-500 mb-1">Scan a barcode, or Generate one</label>
		<input name="barcode_in" autofocus placeholder="scan here…" class="w-full border rounded-lg px-3 py-2"/>
		<div class="mt-3 flex gap-2">
			<button name="action" value="scan" class="px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Use scanned →</button>
			<button name="action" value="generate" class="px-4 py-2 rounded-lg border text-sm">Generate one →</button>
		</div>
	</form>
}

templ StepPrice(w wizard) {
	@stepHeader(5, 6, "Price")
	@bulkProgress(w)
	<form hx-post="/admin/ai-catalog/price" hx-target="#ai-step" hx-swap="innerHTML" x-data={ "{sell:'', markup:'" + w.Markup + "', get cost(){var s=parseFloat(this.sell),m=parseFloat(this.markup); return (s>0&&m>1)?Math.round(s/m):''}}" }>
		@hidden(w)
		<label class="block text-sm text-slate-500 mb-1">Selling price</label>
		<input name="selling_in" x-model="sell" inputmode="decimal" autofocus placeholder="e.g. 500" class="w-full border rounded-lg px-3 py-2"/>
		<div class="mt-2 flex items-center gap-2 text-sm">
			<span class="text-slate-500">÷ markup</span>
			<input name="markup" x-model="markup" inputmode="decimal" class="w-20 border rounded-lg px-2 py-1"/>
			<span class="text-slate-500">= cost</span>
			<span class="font-semibold text-emerald-700" x-text="cost || '—'"></span>
		</div>
		<p class="text-xs text-slate-400 mt-2">Or enter the cost directly:</p>
		<input name="cost_in" inputmode="decimal" placeholder="cost (optional)" class="mt-1 w-40 border rounded-lg px-3 py-2"/>
		<div>
			<button class="mt-3 px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Next: quantity →</button>
		</div>
	</form>
}

templ StepQty(w wizard) {
	@stepHeader(6, 6, "Quantity on hand")
	@bulkProgress(w)
	<form hx-post="/admin/ai-catalog/qty" hx-target="#ai-step" hx-swap="innerHTML">
		@hidden(w)
		<label class="block text-sm text-slate-500 mb-1">How many do you have?</label>
		<input name="qty_in" inputmode="decimal" autofocus placeholder="e.g. 10" class="w-40 border rounded-lg px-3 py-2"/>
		<div>
			<button class="mt-3 px-5 py-2 rounded-lg bg-indigo-600 text-white font-medium">Next: labels →</button>
		</div>
	</form>
}

templ StepLabels(w wizard) {
	<div class="mb-3">
		<span class="text-xs font-semibold text-indigo-600">Last step</span>
		<h2 class="text-lg font-semibold">Print labels &amp; save</h2>
	</div>
	@bulkProgress(w)
	<form hx-post="/admin/ai-catalog/save" hx-target="#ai-step" hx-swap="innerHTML"
		x-data={ "{n:'" + w.Qty + "'}" }>
		@hidden(w)
		<p class="text-sm text-slate-500 mb-2">
			Saving <span class="font-medium text-slate-700">{ w.Name }</span>
			· qty { w.Qty }
			if w.CostPrice != "" {
				· cost { w.CostPrice }
			}
			if w.Selling != "" {
				· sell { w.Selling }
			}
		</p>
		<label class="block text-sm text-slate-500 mb-1">How many labels?</label>
		<div class="flex items-center gap-2">
			<input name="labels" x-model="n" inputmode="numeric" class="w-24 border rounded-lg px-3 py-2"/>
			<button type="button" class="px-3 py-1.5 rounded-lg border text-sm" @click={ "n='" + w.Qty + "'" }>= qty ({ w.Qty })</button>
			<button type="button" class="px-3 py-1.5 rounded-lg border text-sm" @click="n='1'">1</button>
			<button type="button" class="px-3 py-1.5 rounded-lg border text-sm" @click="n='0'">None</button>
		</div>
		<div>
			<button class="mt-4 px-6 py-2.5 rounded-lg bg-emerald-600 text-white font-semibold">✓ Save product</button>
		</div>
	</form>
}
