package alternatives

import (
	"karots-pos/internal/features/products"
	"karots-pos/templates/layouts"
	"strconv"
)

// --- small url/val helpers so the templ stays declarative ---

func groupURL(id int64) string  { return "/admin/alternatives/" + strconv.FormatInt(id, 10) }
func tiersURL(id int64) string  { return "/admin/alternatives/" + strconv.FormatInt(id, 10) + "/tiers" }
func memberURL(tid int64) string {
	return "/admin/alternatives/tiers/" + strconv.FormatInt(tid, 10) + "/members"
}
func searchURL(tid int64) string {
	return "/admin/alternatives/tiers/" + strconv.FormatInt(tid, 10) + "/search"
}
func pidVals(pid int64) string {
	return `{"product_id": "` + strconv.FormatInt(pid, 10) + `"}`
}
func pidValsConfirm(pid int64) string {
	return `{"product_id": "` + strconv.FormatInt(pid, 10) + `", "confirm": "1"}`
}

// GroupsPage is the admin landing: the interchangeable-product groups.
templ GroupsPage(userName string, rows []GroupSummary, showDisabled bool) {
	@layouts.Admin("Alternatives", userName, "alternatives") {
		<div class="p-6 space-y-4">
			<div class="flex items-start justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold">🔀 Alternatives</h1>
					<p class="text-sm text-slate-500">Group interchangeable products into quality tiers. A group is found as a whole at the till, each product shows its tier as a pin, and reorder is judged per tier — not per SKU.</p>
				</div>
				<div class="flex items-center gap-2 shrink-0">
					<a href="/admin/alternatives/reorder" class="px-4 py-2 rounded-lg border font-semibold whitespace-nowrap hover:bg-slate-50">Reorder overview →</a>
					<button
						hx-get="/admin/alternatives/new"
						hx-target="#modal-container"
						hx-swap="innerHTML"
						class="shrink-0 whitespace-nowrap px-4 py-2 rounded-lg bg-indigo-600 text-white font-semibold hover:bg-indigo-700"
					>+ Add group</button>
				</div>
			</div>
			<label class="inline-flex items-center gap-2 text-sm text-slate-600">
				<input
					type="checkbox"
					checked?={ showDisabled }
					hx-get="/admin/alternatives"
					hx-target="#altgroups"
					hx-select="#altgroups"
					hx-swap="outerHTML"
					hx-vals="js:{show_disabled: event.target.checked ? '1' : ''}"
					class="rounded border-slate-300"
				/>
				Show disabled
			</label>
			<div id="altgroups" hx-get="/admin/alternatives" hx-trigger="reload-altgroups from:body" hx-select="#altgroups" hx-swap="outerHTML">
				@GroupsTable(rows)
			</div>
		</div>
	}
}

templ GroupsTable(rows []GroupSummary) {
	<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
		<table class="w-full text-sm">
			<thead class="bg-slate-50 text-slate-500 text-left">
				<tr>
					<th class="px-4 py-3">Group</th>
					<th class="px-4 py-3 text-right">Tiers</th>
					<th class="px-4 py-3 text-right">Products</th>
					<th class="px-4 py-3 text-right">Total qty</th>
					<th class="px-4 py-3 text-right">Actions</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-100">
				if len(rows) == 0 {
					<tr><td colspan="5" class="px-4 py-8 text-center text-slate-400">No groups yet. Add one to start grouping interchangeable products.</td></tr>
				}
				for _, g := range rows {
					<tr class={ templ.KV("opacity-50", !g.IsActive) }>
						<td class="px-4 py-3 font-medium">
							<a class="text-indigo-600 hover:underline" href={ templ.SafeURL(groupURL(g.ID)) }>{ g.Name }</a>
							if !g.IsActive {
								<span class="ml-2 text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">disabled</span>
							}
						</td>
						<td class="px-4 py-3 text-right text-slate-600">{ strconv.Itoa(g.Tiers) }</td>
						<td class="px-4 py-3 text-right text-slate-600">{ strconv.Itoa(g.Products) }</td>
						<td class="px-4 py-3 text-right text-slate-600">{ strconv.Itoa(g.Qty) }</td>
						<td class="px-4 py-3 text-right whitespace-nowrap">
							<a class="text-indigo-600 hover:underline" href={ templ.SafeURL(groupURL(g.ID)) }>Open</a>
							if g.IsActive {
								<button hx-post={ groupURL(g.ID) + "/active" } hx-vals='{"active":""}' hx-swap="none" class="ml-3 text-rose-600 hover:underline">Disable</button>
							} else {
								<button hx-post={ groupURL(g.ID) + "/active" } hx-vals='{"active":"1"}' hx-swap="none" class="ml-3 text-emerald-600 hover:underline">Enable</button>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ GroupForm(g *Group) {
	@altModal("Add group") {
		<form class="px-6 py-4 space-y-4" hx-post="/admin/alternatives" hx-swap="none">
			<div>
				<label class="block text-sm font-medium text-slate-600 mb-1">Group name</label>
				<input type="text" name="name" required placeholder="USB Flash Drive 32GB" class="w-full border rounded-lg px-3 py-2.5"/>
			</div>
			<div>
				<label class="block text-sm font-medium text-slate-600 mb-1">Order</label>
				<input type="number" name="sort_order" value="0" class="w-full border rounded-lg px-3 py-2.5"/>
			</div>
			<div class="flex justify-end gap-3 pt-2">
				<button type="button" class="px-4 py-2 rounded-lg border" x-on:click="$dispatch('close-modal')">Cancel</button>
				<button type="submit" class="px-4 py-2 rounded-lg bg-indigo-600 text-white font-semibold">Save group</button>
			</div>
		</form>
	}
}

// GroupDetailPage shows one group: rename, its tiers (each with reorder level,
// members, and an add-product search), and an add-tier form.
templ GroupDetailPage(userName string, g Group, views []TierView) {
	@layouts.Admin(g.Name, userName, "alternatives") {
		<div class="p-6 space-y-5 max-w-4xl">
			<a href="/admin/alternatives" class="text-sm text-indigo-600 hover:underline">← All groups</a>
			<form class="flex items-end gap-3" hx-put={ groupURL(g.ID) } hx-swap="none">
				<div class="flex-1">
					<label class="block text-sm font-medium text-slate-600 mb-1">Group name</label>
					<input type="text" name="name" required value={ g.Name } class="w-full border rounded-lg px-3 py-2.5"/>
				</div>
				<input type="hidden" name="sort_order" value={ strconv.Itoa(g.SortOrder) }/>
				<button type="submit" class="px-4 py-2.5 rounded-lg border font-semibold hover:bg-slate-50">Rename</button>
			</form>

			<div id="tiers" hx-get={ tiersURL(g.ID) } hx-trigger="reload-altgroup from:body" hx-swap="innerHTML">
				@TiersSection(g.ID, views)
			</div>

			<div class="bg-white rounded-2xl shadow-sm p-4">
				<h3 class="text-sm font-semibold text-slate-600 mb-3">Add a quality tier</h3>
				<form class="flex flex-wrap items-end gap-3" hx-post={ groupURL(g.ID) + "/tiers" } hx-swap="none">
					<div>
						<label class="block text-xs text-slate-500 mb-1">Tier name</label>
						<input type="text" name="name" required placeholder="Genuine" class="border rounded-lg px-3 py-2"/>
					</div>
					<div>
						<label class="block text-xs text-slate-500 mb-1">Reorder level</label>
						<input type="number" name="reorder_level" min="0" value="0" class="w-28 border rounded-lg px-3 py-2"/>
					</div>
					<button type="submit" class="px-4 py-2 rounded-lg bg-indigo-600 text-white font-semibold">Add tier</button>
				</form>
				<p class="text-xs text-slate-400 mt-2">Reorder level 0 = don't track. A tier is flagged low when its total on-hand qty falls to or below this.</p>
			</div>
		</div>
	}
}

// TiersSection is the reload target after any tier/member change.
templ TiersSection(groupID int64, views []TierView) {
	<div class="space-y-4">
		if len(views) == 0 {
			<div class="bg-white rounded-2xl shadow-sm p-6 text-center text-slate-400">No tiers yet. Add a quality tier below (e.g. Genuine, Normal, Cheap).</div>
		}
		for _, v := range views {
			<div class={ "bg-white rounded-2xl shadow-sm p-4", templ.KV("opacity-60", !v.Tier.IsActive) }>
				<div class="flex items-center justify-between gap-3">
					<form class="flex items-end gap-2" hx-put={ "/admin/alternatives/tiers/" + strconv.FormatInt(v.Tier.ID, 10) } hx-swap="none">
						<div>
							<label class="block text-xs text-slate-500 mb-1">Tier</label>
							<input type="text" name="name" value={ v.Tier.Name } class="border rounded-lg px-3 py-1.5 font-medium"/>
						</div>
						<div>
							<label class="block text-xs text-slate-500 mb-1">Reorder level</label>
							<input type="number" name="reorder_level" min="0" value={ strconv.Itoa(v.Tier.ReorderLevel) } class="w-24 border rounded-lg px-3 py-1.5"/>
						</div>
						<input type="hidden" name="sort_order" value={ strconv.Itoa(v.Tier.SortOrder) }/>
						<button type="submit" class="px-3 py-1.5 rounded-lg border text-sm hover:bg-slate-50">Save</button>
					</form>
					if v.Tier.IsActive {
						<button hx-post={ "/admin/alternatives/tiers/" + strconv.FormatInt(v.Tier.ID, 10) + "/active" } hx-vals='{"active":""}' hx-swap="none" class="text-rose-600 hover:underline text-sm">Disable</button>
					} else {
						<button hx-post={ "/admin/alternatives/tiers/" + strconv.FormatInt(v.Tier.ID, 10) + "/active" } hx-vals='{"active":"1"}' hx-swap="none" class="text-emerald-600 hover:underline text-sm">Enable</button>
					}
				</div>

				<div class="mt-3 divide-y divide-slate-100">
					if len(v.Members) == 0 {
						<div class="text-sm text-slate-400 py-2">No products in this tier yet.</div>
					}
					for _, m := range v.Members {
						<div class="flex items-center justify-between py-1.5 text-sm">
							<span>{ m.Name } <span class="text-slate-400">· qty { strconv.Itoa(m.Qty) }</span></span>
							<button hx-delete={ "/admin/alternatives/members/" + strconv.FormatInt(m.ProductID, 10) } hx-swap="none" class="text-rose-600 hover:underline">Remove</button>
						</div>
					}
				</div>

				<div class="mt-3" x-data>
					<label class="block text-xs text-slate-500 mb-1">Add products</label>
					<input
						type="search"
						name="q"
						placeholder="Search products to add…"
						hx-get={ searchURL(v.Tier.ID) }
						hx-trigger="input changed delay:300ms, search"
						hx-target={ "#res-" + strconv.FormatInt(v.Tier.ID, 10) }
						hx-swap="innerHTML"
						class="w-full border rounded-lg px-3 py-2 text-sm"
					/>
					<div id={ "res-" + strconv.FormatInt(v.Tier.ID, 10) } class="mt-1"></div>
				</div>
			</div>
		}
	</div>
}

// ProductResults lists searchable products with an Add button for a tier.
templ ProductResults(tierID int64, rows []products.Product) {
	if len(rows) == 0 {
		<div class="text-xs text-slate-400 px-1 py-1">No matching products.</div>
	} else {
		<div class="border rounded-lg divide-y divide-slate-100 max-h-56 overflow-auto">
			for _, p := range rows {
				<div class="flex items-center justify-between px-3 py-1.5 text-sm">
					<span>{ p.Name }</span>
					@addButton(tierID, p.ID)
				</div>
			}
		</div>
	}
}

templ addButton(tierID, productID int64) {
	<button
		hx-post={ memberURL(tierID) }
		hx-vals={ pidVals(productID) }
		hx-target="this"
		hx-swap="outerHTML"
		class="px-2 py-0.5 rounded border text-indigo-600 hover:bg-indigo-50"
	>Add</button>
}

// MoveConfirmButton replaces the Add button when the product is already in another
// group — one more click moves it here (exactly-one membership).
templ MoveConfirmButton(tierID, productID int64) {
	<button
		hx-post={ memberURL(tierID) }
		hx-vals={ pidValsConfirm(productID) }
		hx-target="this"
		hx-swap="outerHTML"
		class="px-2 py-0.5 rounded border border-amber-300 bg-amber-50 text-amber-700 hover:bg-amber-100"
	>Move here?</button>
}

// ReorderPage is the read-only reorder-by-alternatives overview: per group, each
// tier's total qty vs its reorder level, plus ungrouped low-stock items. The
// actionable reorder→PO flow lives on the core Low Stock page (Filter by
// alternatives); this is the at-a-glance summary.
templ ReorderPage(userName string, rollups []GroupRollup, ungrouped []products.Product) {
	@layouts.Admin("Reorder overview", userName, "alternatives") {
		<div class="p-6 space-y-5 max-w-4xl">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold">Reorder overview</h1>
					<p class="text-sm text-slate-500">Each tier's total on-hand qty vs its reorder level. A tier is low only when the whole interchangeable tier runs down. To actually build a purchase order, use <a href="/admin/reports/low-stock" class="text-indigo-600 hover:underline">Low Stock / Reorder</a> with "Filter by alternatives".</p>
				</div>
				<a href="/admin/alternatives/reorder/export" class="px-4 py-2 rounded-lg border font-semibold whitespace-nowrap hover:bg-slate-50">Export CSV</a>
			</div>
			if len(rollups) == 0 {
				<div class="bg-white rounded-2xl shadow-sm p-6 text-center text-slate-400">No groups yet.</div>
			}
			for _, g := range rollups {
				<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
					<div class="flex items-center justify-between px-4 py-3 bg-slate-50">
						<span class="font-semibold">{ g.Group.Name }</span>
						<span class="text-sm text-slate-500">total qty { strconv.Itoa(g.TotalQty) }</span>
					</div>
					<table class="w-full text-sm">
						<thead class="text-slate-500 text-left">
							<tr>
								<th class="px-4 py-2">Tier</th>
								<th class="px-4 py-2 text-right">Total qty</th>
								<th class="px-4 py-2 text-right">Reorder level</th>
								<th class="px-4 py-2 text-right">Status</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, t := range g.Tiers {
								<tr>
									<td class="px-4 py-2">{ t.Tier.Name }</td>
									<td class="px-4 py-2 text-right">{ strconv.Itoa(t.TotalQty) }</td>
									<td class="px-4 py-2 text-right text-slate-500">{ strconv.Itoa(t.Tier.ReorderLevel) }</td>
									<td class="px-4 py-2 text-right">
										if t.Low {
											<span class="px-2 py-0.5 rounded-full text-xs bg-rose-100 text-rose-700 font-semibold">reorder</span>
										} else {
											<span class="px-2 py-0.5 rounded-full text-xs bg-emerald-100 text-emerald-700">ok</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
				<div class="px-4 py-3 bg-slate-50 font-semibold">Ungrouped low stock</div>
				<table class="w-full text-sm">
					<thead class="text-slate-500 text-left">
						<tr>
							<th class="px-4 py-2">Product</th>
							<th class="px-4 py-2 text-right">On hand</th>
							<th class="px-4 py-2 text-right">Reorder level</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						if len(ungrouped) == 0 {
							<tr><td colspan="3" class="px-4 py-6 text-center text-slate-400">Nothing ungrouped is low. 🎉</td></tr>
						}
						for _, p := range ungrouped {
							<tr>
								<td class="px-4 py-2">{ p.Name }</td>
								<td class="px-4 py-2 text-right">{ p.StockQty.String() }</td>
								<td class="px-4 py-2 text-right text-slate-500">{ strconv.Itoa(p.ReorderLevel) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

// altModal mirrors the core admin modal shell (swapped into #modal-container,
// dismissed by the "close-modal" event).
templ altModal(title string) {
	<div class="fixed inset-0 bg-black/40 flex items-center justify-center z-40 p-4" x-data>
		<div class="bg-white rounded-2xl shadow-xl w-full max-w-md max-h-full overflow-auto">
			<div class="flex items-center justify-between px-6 py-4 border-b">
				<h3 class="text-lg font-semibold">{ title }</h3>
				<button class="text-slate-400 hover:text-slate-600" x-on:click="$dispatch('close-modal')">✕</button>
			</div>
			{ children... }
		</div>
	</div>
}
