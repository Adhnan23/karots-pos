package recharge

import adminfragments "karots-pos/templates/fragments/admin"

// CashierRefillForm is the counter "buy reload float from a supplier" modal,
// reached from the cashier Suppliers page (the plugin.CashierSupplierAction
// button). Unlike the admin refill it pays only from the sources this cashier is
// allowed to touch — their own drawer + the cashier-access lockers — the same
// restriction the core supplier counter uses. Carriers/devices load over the
// cashier endpoints so the balance shown is what the cashier sees at their till.
templ CashierRefillForm(sources []adminfragments.LocationChoice) {
	<div class="fixed inset-0 bg-black/40 flex items-center justify-center z-40 p-4" x-data>
		<div class="bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-full overflow-auto">
			<div class="flex items-center justify-between px-6 py-4 border-b">
				<h3 class="text-lg font-semibold">Buy reload float</h3>
				<button class="text-slate-400 hover:text-slate-600" x-on:click="$dispatch('close-modal')">✕</button>
			</div>
			<form
				class="p-6 space-y-4"
				x-data="{ carriers:[], devices:[], cid:'', did:'',
				          async load(){ try{ const r=await fetch('/cashier/recharge/carriers'); const j=await r.json(); this.carriers=j.data||[]; if(this.carriers.length){ this.cid=String(this.carriers[0].id) } await this.loadDevices(); }catch(e){} },
				          async loadDevices(){ this.devices=[]; this.did=''; if(!this.cid){ return } try{ const r=await fetch('/cashier/recharge/devices?for=recharge&carrier_id='+encodeURIComponent(this.cid)); const j=await r.json(); this.devices=j.data||[]; if(this.devices.length){ this.did=String(this.devices[0].id) } }catch(e){} },
				          dev(){ return this.devices.find(x=>String(x.id)===String(this.did)) },
				          bal(){ const x=this.dev(); return x?Number(x.balance):0 } }"
				x-init="load()"
				hx-post="/cashier/recharge/refill"
				hx-swap="none"
			>
				<p class="text-xs text-slate-500">Increases the device's reload balance, books a shop expense, and pays the supplier from the cash source you pick — nothing else the owner keeps off-limits.</p>
				<div>
					<label class="block text-sm font-medium text-slate-600 mb-1">Carrier</label>
					<select x-model="cid" x-on:change="loadDevices()" class="w-full border rounded-lg px-3 py-2.5">
						<template x-for="c in carriers" x-bind:key="c.id">
							<option x-bind:value="c.id" x-text="c.name"></option>
						</template>
					</select>
					<p x-show="carriers.length===0" class="text-xs text-rose-500 mt-1">No carriers set up.</p>
				</div>
				<div>
					<label class="block text-sm font-medium text-slate-600 mb-1">Device</label>
					<select name="device_id" x-model="did" required class="w-full border rounded-lg px-3 py-2.5">
						<template x-for="d in devices" x-bind:key="d.id">
							<option x-bind:value="d.id" x-text="d.label + (d.number ? ' · '+d.number : '')"></option>
						</template>
					</select>
					<p x-show="dev()" class="text-xs text-slate-500 mt-1">Current reload balance: <span class="font-semibold tabular-nums" x-text="bal().toFixed(2)"></span></p>
					<p x-show="devices.length===0 && cid" class="text-xs text-rose-500 mt-1">This carrier has no reload device — open your till first if you just did.</p>
				</div>
				<div>
					<label class="block text-sm font-medium text-slate-600 mb-1">Amount</label>
					<input type="number" name="amount" min="0" step="0.01" required placeholder="0.00" class="w-full border rounded-lg px-3 py-2.5 text-right"/>
				</div>
				<div>
					<label class="block text-sm font-medium text-slate-600 mb-1">Pay from</label>
					@adminfragments.LocationPicker("source", "— pick cash source —", sources)
					<p class="text-xs text-slate-500 mt-1">Paying from your drawer needs your till open.</p>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-sm font-medium text-slate-600 mb-1">Reference</label>
						<input type="text" name="reference" placeholder="txn no." class="w-full border rounded-lg px-3 py-2.5"/>
					</div>
					<div>
						<label class="block text-sm font-medium text-slate-600 mb-1">Note</label>
						<input type="text" name="note" class="w-full border rounded-lg px-3 py-2.5"/>
					</div>
				</div>
				<div class="flex justify-end gap-3 pt-2">
					<button type="button" class="px-4 py-2 rounded-lg border" x-on:click="$dispatch('close-modal')">Cancel</button>
					<button type="submit" x-bind:disabled="!did" class="px-4 py-2 rounded-lg bg-indigo-600 text-white disabled:opacity-40">Buy float</button>
				</div>
			</form>
		</div>
	</div>
}
