package repairs

import (
	"strconv"

	"karots-pos/internal/features/cashregister"
	"karots-pos/internal/money"
	"karots-pos/templates/layouts"
	"karots-pos/templates/shared"
)

// ---- view models ----

type ListRow struct {
	ID         int64
	TicketNo   string
	Customer   string
	Phone      string
	Device     string
	RepairType string
	Status     string
	DueLabel   string
	Urgent     bool
}

type ListData struct {
	UserName string
	Show     string // active filter: open | collected | cancelled | all
	Rows     []ListRow
}

// listTab renders one status filter tab, highlighted when active.
templ listTab(active, key, label string) {
	if active == key {
		<a href={ templ.SafeURL("/admin/repairs?show=" + key) } class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm font-medium">{ label }</a>
	} else {
		<a href={ templ.SafeURL("/admin/repairs?show=" + key) } class="px-3 py-1.5 rounded-lg border text-sm text-slate-600 hover:bg-slate-50">{ label }</a>
	}
}

type FormData struct {
	UserName     string
	Types        []string
	Models       []string
	Repairers    []string
	WarrantyDays int
}

type DetailData struct {
	UserName      string
	Symbol        string
	D             *Detail
	Total         string
	Deposit       string
	Balance       string
	RepairerPaid  string
	DueLabel      string
	Urgent        bool
	WarrantyLabel string
	Editable      bool
	Tills         []cashregister.SessionRow
	Warning       string // shown inline on the cashier job panel (e.g. till not open)
}

// statusBadge maps a status to a Tailwind colour chip.
func statusBadge(s string) string {
	switch s {
	case "ready":
		return "bg-emerald-100 text-emerald-700"
	case "collected":
		return "bg-slate-100 text-slate-600"
	case "cancelled":
		return "bg-rose-100 text-rose-700"
	default:
		return "bg-amber-100 text-amber-700"
	}
}

// ---- pages ----

templ RepairsListPage(d ListData) {
	@layouts.Admin("Repairs", d.UserName, "repairs") {
		<div class="flex items-center justify-between mb-4">
			<h1 class="text-2xl font-bold">Repairs</h1>
			<a href="/admin/repairs/new" class="px-4 py-2 rounded-lg bg-indigo-600 text-white font-semibold">+ New repair</a>
		</div>
		<div class="flex flex-wrap gap-2 mb-4">
			@listTab(d.Show, "open", "Open")
			@listTab(d.Show, "collected", "Collected")
			@listTab(d.Show, "cancelled", "Cancelled")
			@listTab(d.Show, "all", "All")
		</div>
		<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
			<table class="w-full text-sm">
				<thead class="text-left text-slate-500 border-b">
					<tr>
						<th class="py-2 px-3">Ticket</th>
						<th class="py-2 px-3">Customer</th>
						<th class="py-2 px-3">Device</th>
						<th class="py-2 px-3">Type</th>
						<th class="py-2 px-3">Status</th>
						<th class="py-2 px-3">Due</th>
						<th class="py-2 px-3"></th>
					</tr>
				</thead>
				<tbody>
					if len(d.Rows) == 0 {
						<tr><td class="py-6 px-3 text-slate-400" colspan="7">No open repairs. Click “New repair” to start one.</td></tr>
					}
					for _, r := range d.Rows {
						<tr class="border-b last:border-0 hover:bg-slate-50">
							<td class="py-2 px-3 font-medium">{ r.TicketNo }</td>
							<td class="py-2 px-3">
								{ r.Customer }
								if r.Phone != "" {
									<span class="block text-xs text-slate-400">{ r.Phone }</span>
								}
							</td>
							<td class="py-2 px-3">{ r.Device }</td>
							<td class="py-2 px-3">{ r.RepairType }</td>
							<td class="py-2 px-3"><span class={ "px-2 py-0.5 rounded-full text-xs " + statusBadge(r.Status) }>{ r.Status }</span></td>
							<td class="py-2 px-3">
								if r.Urgent {
									<span class="text-rose-600 font-semibold">{ r.DueLabel }</span>
								} else {
									<span class="text-slate-500">{ r.DueLabel }</span>
								}
							</td>
							<td class="py-2 px-3 text-right"><a class="text-indigo-600" href={ templ.SafeURL("/admin/repairs/" + strconv.FormatInt(r.ID, 10)) }>Open →</a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ RepairFormPage(d FormData) {
	@layouts.Admin("New Repair", d.UserName, "repairs") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">New repair</h1>
			<a href="/admin/repairs" class="text-slate-500 hover:underline">← Back</a>
		</div>
		<form method="post" action="/admin/repairs" class="bg-white rounded-2xl shadow-sm p-6 max-w-2xl space-y-4">
			<div class="md:col-span-2">
				@customerPickerFields()
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<div>
					<label class="block text-sm font-medium mb-1">Repair type</label>
					<input name="repair_type" list="repair-types" class="w-full border rounded-lg px-3 py-2" placeholder="e.g. Screen replace"/>
					<datalist id="repair-types">
						for _, t := range d.Types {
							<option value={ t }></option>
						}
					</datalist>
				</div>
				<div>
					<label class="block text-sm font-medium mb-1">Device model</label>
					<input name="device_model" list="repair-models" class="w-full border rounded-lg px-3 py-2" placeholder="e.g. iPhone 11"/>
					<datalist id="repair-models">
						for _, m := range d.Models {
							<option value={ m }></option>
						}
					</datalist>
				</div>
				<div>
					<label class="block text-sm font-medium mb-1">Repaired by</label>
					<input name="repaired_by" list="repair-people" class="w-full border rounded-lg px-3 py-2" placeholder="Leave blank for in-house (us)"/>
					<datalist id="repair-people">
						for _, r := range d.Repairers {
							<option value={ r }></option>
						}
					</datalist>
				</div>
			</div>
			<div>
				<label class="block text-sm font-medium mb-1">Reported fault</label>
				<textarea name="fault" rows="2" class="w-full border rounded-lg px-3 py-2" placeholder="What's wrong…"></textarea>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<div>
					<label class="block text-sm font-medium mb-1">Promised date</label>
					<input type="date" name="promised_date" class="w-full border rounded-lg px-3 py-2"/>
				</div>
				<div>
					<label class="block text-sm font-medium mb-1">Warranty (days)</label>
					<input type="number" min="0" name="warranty_days" value={ strconv.Itoa(d.WarrantyDays) } class="w-full border rounded-lg px-3 py-2"/>
				</div>
				<div class="flex items-end">
					<label class="flex items-center gap-2 text-sm"><input type="checkbox" name="urgent" value="1"/> Mark urgent</label>
				</div>
			</div>
			<div>
				<label class="block text-sm font-medium mb-1">Notes</label>
				<input name="notes" class="w-full border rounded-lg px-3 py-2" placeholder="Optional…"/>
			</div>
			<div class="flex justify-end">
				<button type="submit" class="px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-semibold">Open repair</button>
			</div>
		</form>
	}
}

templ RepairDetailPage(d DetailData) {
	@layouts.Admin("Repair "+d.D.Job.TicketNo, d.UserName, "repairs") {
		<div class="flex items-center justify-between mb-6">
			<div>
				<h1 class="text-2xl font-bold">{ d.D.Job.TicketNo }
					<span class={ "ml-2 px-2 py-0.5 rounded-full text-sm align-middle " + statusBadge(d.D.Job.Status) }>{ d.D.Job.Status }</span>
				</h1>
				<p class="text-sm text-slate-500">{ d.D.Job.RepairType } · { d.D.Job.DeviceModel }</p>
			</div>
			<a href="/admin/repairs" class="text-slate-500 hover:underline">← Back</a>
		</div>
		<div class="grid gap-6 lg:grid-cols-3 items-start">
			<div class="lg:col-span-2 space-y-6">
				@RepairLines(d)
			</div>
			<div class="space-y-6">
				<div class="bg-white rounded-2xl shadow-sm p-5 text-sm space-y-1">
					<div class="font-semibold mb-1">Customer</div>
					<div>{ d.D.Job.CustomerName }</div>
					if d.D.Job.CustomerPhone != "" {
						<div class="text-slate-500">{ d.D.Job.CustomerPhone }</div>
					}
					<div class="pt-2 font-semibold">Fault</div>
					<div class="text-slate-600">{ d.D.Job.Fault }</div>
					<div class="pt-2 flex justify-between"><span class="text-slate-500">Repaired by</span>
						if d.D.Job.RepairedBy != "" {
							<span>{ d.D.Job.RepairedBy }</span>
						} else {
							<span class="text-slate-400">us</span>
						}
					</div>
					<div class="flex justify-between"><span class="text-slate-500">Due</span>
						if d.Urgent {
							<span class="text-rose-600 font-semibold">{ d.DueLabel }</span>
						} else {
							<span>{ d.DueLabel }</span>
						}
					</div>
					if d.WarrantyLabel != "" {
						<div class="flex justify-between"><span class="text-slate-500">Warranty</span><span>{ d.WarrantyLabel }</span></div>
					}
					<div class="pt-2 mt-1 border-t text-xs text-slate-400">Customer pays at the cashier till. This page is for managing the job and paying the repairer.</div>
				</div>
				if d.Editable {
					<div class="bg-white rounded-2xl shadow-sm p-5">
						<div class="font-semibold text-sm mb-2">Status</div>
						<div class="flex flex-wrap gap-2">
							@statusButton(d.D.Job.ID, "received", "Received")
							@statusButton(d.D.Job.ID, "in_progress", "In progress")
							@statusButton(d.D.Job.ID, "ready", "Ready")
						</div>
					</div>
					<div class="bg-white rounded-2xl shadow-sm p-5 space-y-2">
						<div class="font-semibold text-sm">Pay the repairer</div>
						<p class="text-xs text-slate-500">If an outside person did the repair, pay them here — it books as an expense. In-house work needs no payout.</p>
						<form method="post" action={ templ.SafeURL("/admin/repairs/" + strconv.FormatInt(d.D.Job.ID, 10) + "/pay-repairer") } class="space-y-2">
							<input name="amount" type="number" step="0.01" min="0" placeholder="Amount to pay" class="w-full border rounded px-2 py-1 text-sm text-right"/>
							<input name="note" placeholder="Note (optional)" class="w-full border rounded px-2 py-1 text-sm"/>
							<label class="block text-xs text-slate-500">Take the cash from</label>
							<select name="source" class="w-full border rounded px-2 py-1 text-sm">
								<option value="">— just record the expense (untracked) —</option>
								for _, t := range d.Tills {
									<option value={ strconv.FormatInt(t.UserID, 10) }>{ "Till: " + t.UserName }</option>
								}
							</select>
							<button class="w-full px-3 py-1.5 rounded bg-slate-700 text-white text-sm font-semibold">Pay repairer</button>
						</form>
						if d.RepairerPaid != "" {
							<div class="text-xs text-slate-500">Paid to repairer so far: <span class="font-medium">{ d.RepairerPaid }</span></div>
						}
						<form method="post" action={ templ.SafeURL("/admin/repairs/" + strconv.FormatInt(d.D.Job.ID, 10) + "/cancel") } x-on:submit="return confirm('Cancel this repair?')" class="pt-2 border-t">
							<button class="w-full px-3 py-1 rounded border text-rose-600 text-sm">Cancel repair</button>
						</form>
					</div>
				}
				if d.D.Job.Status == "collected" && d.D.Job.SaleID != nil {
					<div class="bg-white rounded-2xl shadow-sm p-5 text-sm">
						<div class="font-semibold mb-1">Collected</div>
						<a class="text-indigo-600" href={ templ.SafeURL("/admin/repairs/" + strconv.FormatInt(d.D.Job.ID, 10) + "/receipt") }>Print repair receipt →</a>
					</div>
				}
			</div>
		</div>
	}
}

templ statusButton(id int64, status, label string) {
	<form method="post" action={ templ.SafeURL("/admin/repairs/" + strconv.FormatInt(id, 10) + "/status") }>
		<input type="hidden" name="status" value={ status }/>
		<button type="submit" class="px-3 py-1.5 rounded-lg border text-sm hover:bg-slate-50">{ label }</button>
	</form>
}

// RepairLines renders the parts + charges + totals block, with add/remove forms
// when the job is still editable. Deposit/collect actions arrive in Task 7.
templ RepairLines(d DetailData) {
	<div id="repair-lines" class="bg-white rounded-2xl shadow-sm p-5">
		<div class="font-semibold text-sm mb-2">Parts</div>
		<table class="w-full text-sm mb-2">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1">Item</th><th class="py-1 text-right w-20">Qty</th><th class="py-1 text-right w-28">Unit</th><th class="py-1 text-right w-24">Disc.</th><th class="py-1 text-right w-28">Total</th><th class="w-8"></th></tr>
			</thead>
			<tbody>
				if len(d.D.Parts) == 0 {
					<tr><td class="py-2 text-slate-400" colspan="6">No parts added.</td></tr>
				}
				for _, p := range d.D.Parts {
					<tr class="border-b last:border-0">
						<td class="py-1">{ p.ProductName }</td>
						<td class="py-1 text-right">{ p.Qty.String() }</td>
						<td class="py-1 text-right">{ money.Format(d.Symbol, p.UnitCharge) }</td>
						<td class="py-1 text-right text-rose-600">{ money.Format(d.Symbol, p.Discount) }</td>
						<td class="py-1 text-right">{ money.Format(d.Symbol, p.Qty.Mul(p.UnitCharge).Sub(p.Discount)) }</td>
						<td class="py-1 text-right">
							if d.Editable {
								@removeForm("/admin/repairs/part/"+strconv.FormatInt(p.ID, 10)+"/delete", d.D.Job.ID)
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		if d.Editable {
			@addPartForm(d)
		}
		<div class="font-semibold text-sm mb-2 mt-4">Charges</div>
		<table class="w-full text-sm mb-2">
			<tbody>
				if len(d.D.Charges) == 0 {
					<tr><td class="py-2 text-slate-400" colspan="3">No charges added.</td></tr>
				}
				for _, ch := range d.D.Charges {
					<tr class="border-b last:border-0">
						<td class="py-1">{ ch.Label }</td>
						<td class="py-1 text-right">{ money.Format(d.Symbol, ch.Amount) }</td>
						<td class="py-1 text-right w-8">
							if d.Editable {
								@removeForm("/admin/repairs/charge/"+strconv.FormatInt(ch.ID, 10)+"/delete", d.D.Job.ID)
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		if d.Editable {
			<form method="post" action={ templ.SafeURL("/admin/repairs/" + strconv.FormatInt(d.D.Job.ID, 10) + "/charge") } class="flex gap-2 mb-4">
				<input name="label" placeholder="Charge (e.g. Labour)" class="flex-1 border rounded px-2 py-1 text-sm"/>
				<input name="amount" type="number" step="0.01" min="0" placeholder="0.00" class="w-28 border rounded px-2 py-1 text-sm text-right"/>
				<button class="px-3 py-1 rounded bg-slate-700 text-white text-sm">Add</button>
			</form>
		}
		<div class="border-t pt-3 text-sm space-y-1">
			<div class="flex justify-between"><span class="text-slate-500">Total</span><span class="font-semibold">{ d.Total }</span></div>
			<div class="flex justify-between"><span class="text-slate-500">Deposit paid</span><span>{ d.Deposit }</span></div>
			<div class="flex justify-between text-base"><span class="font-semibold">Balance due</span><span class="font-bold">{ d.Balance }</span></div>
		</div>
	</div>
}

templ removeForm(action string, jobID int64) {
	<form method="post" action={ templ.SafeURL(action) }>
		<input type="hidden" name="job_id" value={ strconv.FormatInt(jobID, 10) }/>
		<button class="text-rose-500 hover:text-rose-700" title="Remove">✕</button>
	</form>
}

// addPartForm is a small live product search that fills a hidden product_id and
// posts a normal form (full reload). unit price comes from the catalogue server-side.
templ addPartForm(d DetailData) {
	<form method="post" action={ templ.SafeURL("/admin/repairs/" + strconv.FormatInt(d.D.Job.ID, 10) + "/part") } x-data="repairPartPicker()" class="mb-2">
		<div class="flex flex-wrap gap-2 items-start">
			<div class="relative flex-1 min-w-48" x-on:click.away="open=false">
				<input type="text" x-model="q" x-on:input="search()" x-on:focus="open=true" placeholder="Search part…" class="w-full border rounded px-2 py-1 text-sm"/>
				<input type="hidden" name="product_id" x-bind:value="productId"/>
				<div x-show="open && results.length" x-cloak class="absolute z-20 left-0 right-0 mt-1 bg-white border rounded-lg shadow max-h-56 overflow-auto">
					<template x-for="r in results" x-bind:key="r.id">
						<button type="button" x-on:click="pick(r)" class="block w-full text-left px-3 py-1.5 hover:bg-slate-100 text-sm" x-text="r.name + (r.barcode ? '  ·  ' + r.barcode : '')"></button>
					</template>
				</div>
			</div>
			<input name="qty" type="number" step="0.001" min="0" value="1" class="w-20 border rounded px-2 py-1 text-sm text-center" title="Qty"/>
			<div class="flex items-center rounded border">
				<input name="discount" type="number" step="0.01" min="0" placeholder="0" class="w-20 px-1 py-1 text-sm text-right" title="Discount"/>
				<select name="discount_type" class="border-l px-1 py-1 text-xs bg-slate-50"><option value="fixed">Rs</option><option value="percent">%</option></select>
			</div>
			<button type="submit" x-bind:disabled="!productId" class="px-3 py-1 rounded bg-indigo-600 text-white text-sm disabled:opacity-40">Add part</button>
		</div>
	</form>
	<script>
		function repairPartPicker(){
			return {
				q:"", productId:"", results:[], open:false, _t:null, _seq:0,
				async search(){
					const q=this.q.trim();
					if(!q){ this.results=[]; this.open=false; return; }
					const seq=++this._seq;
					if(this._t) clearTimeout(this._t);
					await new Promise(r=>{ this._t=setTimeout(r,200); });
					if(seq!==this._seq) return;
					try{
						const res=await fetch("/api/products?limit=20&search="+encodeURIComponent(q),{credentials:"same-origin"});
						const j=await res.json();
						if(seq!==this._seq) return;
						this.results=(j.data||[]); this.open=true;
					}catch(e){ this.results=[]; }
				},
				pick(r){ this.productId=String(r.id); this.q=r.name; this.results=[]; this.open=false; },
			};
		}
	</script>
}

// ---- receipt ----

type ReceiptData struct {
	Symbol        string
	ShopName      string
	Address       *string
	Phone         *string
	Footer        *string
	D             *Detail
	Total         string
	Deposit       string
	Balance       string
	WarrantyLabel string
}

// RepairReceipt is a standalone, thermal-styled slip matching the sales receipt
// (same r-* classes + roll @page sizing from app.css). It is the supplementary
// detailed doc (parts + warranty); the customer's money slip is the core sale
// receipt. Printed via the browser (this is not the ESC/POS money slip).
templ RepairReceipt(d ReceiptData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Repair { d.D.Job.TicketNo }</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			@templ.Raw("<style>@media print{@page{size:80mm auto;margin:0}html,body{width:80mm;height:auto;margin:0}}</style>")
		</head>
		<body class="receipt-body">
			<div class="receipt" id="receipt">
				<div class="r-center r-shop">{ d.ShopName }</div>
				if d.Address != nil && *d.Address != "" {
					<div class="r-center r-small">{ *d.Address }</div>
				}
				if d.Phone != nil && *d.Phone != "" {
					<div class="r-center r-small">Tel: { *d.Phone }</div>
				}
				<div class="r-hr"></div>
				<div class="r-center r-shop">REPAIR</div>
				<div class="r-center r-small">{ d.D.Job.TicketNo }</div>
				<div class="r-hr"></div>
				<div class="r-row r-small"><span>Date</span><span>{ d.D.Job.CreatedAt.Format("2006-01-02 15:04") }</span></div>
				<div class="r-row r-small"><span>Device</span><span>{ d.D.Job.RepairType } · { d.D.Job.DeviceModel }</span></div>
				if d.D.Job.Fault != "" {
					<div class="r-row r-small"><span>Fault</span><span>{ d.D.Job.Fault }</span></div>
				}
				if d.D.Job.CustomerName != "" {
					<div class="r-row r-small"><span>Customer</span><span>{ d.D.Job.CustomerName } { d.D.Job.CustomerPhone }</span></div>
				}
				<div class="r-hr"></div>
				<table class="r-items">
					<tbody>
						for _, p := range d.D.Parts {
							<tr class="r-item-name"><td colspan="2">{ p.ProductName }</td></tr>
							<tr class="r-item-line">
								<td>{ money.Display(p.Qty) } × { money.Display(p.UnitCharge) }</td>
								<td class="r-right">{ money.Display(p.Qty.Mul(p.UnitCharge).Sub(p.Discount)) }</td>
							</tr>
						}
						for _, ch := range d.D.Charges {
							<tr class="r-item-line">
								<td>{ ch.Label }</td>
								<td class="r-right">{ money.Display(ch.Amount) }</td>
							</tr>
						}
					</tbody>
				</table>
				<div class="r-hr"></div>
				<div class="r-row"><span>Total</span><span>{ d.Total }</span></div>
				<div class="r-row"><span>Deposit</span><span>{ d.Deposit }</span></div>
				<div class="r-row r-total"><span>BALANCE</span><span>{ d.Balance }</span></div>
				<div class="r-hr"></div>
				if d.WarrantyLabel != "" {
					<div class="r-center r-small">Warranty until { d.WarrantyLabel }</div>
				}
				@shared.ThermalFooter(d.Footer)
				<div class="r-print-btn">
					<button onclick="window.print()">🖨 Print</button>
					<button type="button" class="r-secondary" onclick="window.history.length>1?window.history.back():window.close()">← Back</button>
				</div>
			</div>
		</body>
	</html>
}

// ---- receipts tab (inside the core Receipts page) ----

type ReceiptsTabData struct {
	Symbol  string
	BaseURL string // "/admin/repairs" or "/cashier/repairs"
	Jobs    []Job
}

templ RepairsReceiptsTab(d ReceiptsTabData) {
	<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
		<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b bg-slate-50">
				<tr>
					<th class="px-4 py-2">Ticket</th>
					<th class="px-4 py-2">Device</th>
					<th class="px-4 py-2">Customer</th>
					<th class="px-4 py-2">Collected</th>
					<th class="px-4 py-2 text-right">Receipt</th>
				</tr>
			</thead>
			<tbody>
				if len(d.Jobs) == 0 {
					<tr><td colspan="5" class="px-4 py-8 text-center text-slate-400">No collected repairs yet.</td></tr>
				}
				for _, j := range d.Jobs {
					<tr class="border-b last:border-0">
						<td class="px-4 py-2 font-medium">{ j.TicketNo }</td>
						<td class="px-4 py-2">{ j.DeviceModel }</td>
						<td class="px-4 py-2 text-slate-500">{ j.CustomerName }</td>
						<td class="px-4 py-2 text-slate-500 whitespace-nowrap">
							if j.CollectedAt != nil {
								{ j.CollectedAt.Format("2006-01-02 15:04") }
							}
						</td>
						<td class="px-4 py-2 text-right whitespace-nowrap">
							if j.SaleID != nil {
								<a class="text-indigo-600 hover:underline" target="_blank" href={ templ.SafeURL("/cashier/receipt/" + strconv.FormatInt(*j.SaleID, 10)) }>Sale slip</a>
								<span class="text-slate-300 mx-1">·</span>
							}
							<a class="text-indigo-600 hover:underline" target="_blank" href={ templ.SafeURL(d.BaseURL + "/" + strconv.FormatInt(j.ID, 10) + "/receipt") }>Repair slip</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// ---- report ----

type ReportRow struct {
	TicketNo  string
	Device    string
	Collected string
	Total     string
	Warranty  string
}

type ReportData struct {
	UserName string
	Preset   string
	FromLbl  string
	ToLbl    string
	Rows     []ReportRow
	GrandTot string
	Count    int
}

// reportPreset renders one date-preset link for the report (full-page nav).
templ reportPreset(active, key, label string) {
	if active == key {
		<a href={ templ.SafeURL("/admin/repairs/report?preset=" + key) } class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-sm">{ label }</a>
	} else {
		<a href={ templ.SafeURL("/admin/repairs/report?preset=" + key) } class="px-3 py-1.5 rounded-lg border text-slate-600 text-sm hover:bg-slate-50">{ label }</a>
	}
}

templ RepairsReportPage(d ReportData) {
	@layouts.Admin("Repairs report", d.UserName, "repairs") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Repairs report</h1>
			<a href="/admin/repairs" class="text-slate-500 hover:underline">← Repairs</a>
		</div>
		<div class="flex flex-wrap gap-2 mb-3">
			@reportPreset(d.Preset, "today", "Today")
			@reportPreset(d.Preset, "this-week", "This week")
			@reportPreset(d.Preset, "this-month", "This month")
			@reportPreset(d.Preset, "last-week", "Last week")
			@reportPreset(d.Preset, "last-month", "Last month")
			@reportPreset(d.Preset, "this-year", "This year")
		</div>
		<form method="get" class="flex gap-2 items-end mb-4">
			<div><label class="block text-xs text-slate-500">From</label><input type="date" name="from" value={ d.FromLbl } class="border rounded px-2 py-1 text-sm"/></div>
			<div><label class="block text-xs text-slate-500">To</label><input type="date" name="to" value={ d.ToLbl } class="border rounded px-2 py-1 text-sm"/></div>
			<button class="px-3 py-1.5 rounded bg-indigo-600 text-white text-sm">Apply</button>
		</form>
		<div class="bg-white rounded-2xl shadow-sm overflow-hidden">
			<table class="w-full text-sm">
				<thead class="text-left text-slate-500 border-b">
					<tr><th class="py-2 px-3">Ticket</th><th class="py-2 px-3">Device</th><th class="py-2 px-3">Collected</th><th class="py-2 px-3 text-right">Revenue</th><th class="py-2 px-3">Warranty</th></tr>
				</thead>
				<tbody>
					if len(d.Rows) == 0 {
						<tr><td class="py-4 px-3 text-slate-400" colspan="5">No repairs collected in this range.</td></tr>
					}
					for _, r := range d.Rows {
						<tr class="border-b last:border-0">
							<td class="py-2 px-3 font-medium">{ r.TicketNo }</td>
							<td class="py-2 px-3">{ r.Device }</td>
							<td class="py-2 px-3">{ r.Collected }</td>
							<td class="py-2 px-3 text-right">{ r.Total }</td>
							<td class="py-2 px-3">{ r.Warranty }</td>
						</tr>
					}
				</tbody>
				<tfoot class="border-t font-bold">
					<tr><td class="py-2 px-3" colspan="3">{ strconv.Itoa(d.Count) } repairs</td><td class="py-2 px-3 text-right">{ d.GrandTot }</td><td></td></tr>
				</tfoot>
			</table>
		</div>
	}
}

// ---- dashboard card ----

templ ReadyCard() {
	<a href="/admin/repairs" class="block bg-white rounded-2xl shadow-sm p-5 hover:shadow">
		<div class="text-slate-500 text-sm">🔧 Repairs ready for pickup</div>
		<div class="text-3xl font-bold" hx-get="/admin/repairs/ready-count" hx-trigger="load" hx-swap="innerHTML">–</div>
	</a>
}

// customerPickerFields renders the customer search/register block shared by the
// admin new-job form and the cashier apply fragment. It reuses the existing
// /api/customers endpoints (GET to search, POST to register) — no core change.
// It submits customer_name, customer_phone, and (when picked/registered) a
// hidden customer_id.
templ customerPickerFields() {
	<div x-data="{ q:'', phone:'', id:'', results:[], open:false, _t:null, _seq:0,
			async search(){ this.id=''; const q=this.q.trim(); if(!q){ this.results=[]; this.open=false; return; }
				const seq=++this._seq; if(this._t) clearTimeout(this._t); await new Promise(r=>{ this._t=setTimeout(r,200); }); if(seq!==this._seq) return;
				try{ const res=await fetch('/api/customers?search='+encodeURIComponent(q),{credentials:'same-origin'}); const j=await res.json(); if(seq!==this._seq) return;
					const rows=(j.data||[]); this.results=rows.filter(c=>((c.name||'')+' '+(c.phone||'')).toLowerCase().includes(q.toLowerCase())).slice(0,15); this.open=true; }catch(e){ this.results=[]; } },
			pick(r){ this.id=String(r.id); this.q=r.name||''; this.phone=r.phone||''; this.results=[]; this.open=false; },
			async register(){ const name=this.q.trim(), phone=this.phone.trim(); if(!name||this.id) return;
				try{ const res=await fetch('/api/customers',{method:'POST',headers:{'Content-Type':'application/json'},credentials:'same-origin',body:JSON.stringify({name:name,phone:phone})});
					const j=await res.json(); if(j&&j.data&&j.data.id){ this.id=String(j.data.id); this.open=false; window.dispatchEvent(new CustomEvent('show-toast',{detail:{message:'Customer saved',level:'success'}})); } }catch(e){} } }" class="relative">
		<label class="block text-sm font-medium mb-1">Customer</label>
		<div class="flex gap-2">
			<input x-model="q" x-on:input="search()" x-on:focus="open=true" name="customer_name" placeholder="Search a saved customer, or type a new name…" autocomplete="off" class="flex-1 border rounded-lg px-3 py-2"/>
			<input x-model="phone" x-on:blur="register()" name="customer_phone" placeholder="Phone" class="w-40 border rounded-lg px-3 py-2"/>
		</div>
		<input type="hidden" name="customer_id" x-bind:value="id"/>
		<div class="mt-1 text-xs">
			<span x-show="id" class="text-emerald-600">✓ saved customer</span>
			<button type="button" x-show="!id && q && phone" x-on:click="register()" class="text-indigo-600 hover:underline">+ Save as a new customer</button>
			<span x-show="!id && q && !phone" class="text-slate-400">add a phone to save this customer</span>
		</div>
		<div x-show="open && results.length" x-cloak x-on:click.away="open=false" class="absolute z-30 left-0 right-0 mt-1 bg-white border rounded-lg shadow max-h-56 overflow-auto">
			<template x-for="r in results" x-bind:key="r.id">
				<button type="button" x-on:click="pick(r)" class="block w-full text-left px-3 py-1.5 hover:bg-slate-100 text-sm" x-text="r.name + (r.phone ? '  ·  ' + r.phone : '')"></button>
			</template>
		</div>
	</div>
}
