package adminpages

import (
	"strconv"

	"karots-pos/internal/features/sales"
	"karots-pos/internal/money"
	"karots-pos/templates/layouts"
)

type SalesData struct {
	UserName string
	Symbol   string
	Rows     []sales.Sale
	Preset   string
	From     string
	To       string
	Status   string
	Query    string
	Method   string
	Page     int
	HasNext  bool
}

templ SalesPage(d SalesData) {
	@layouts.Admin("Sales", d.UserName, "sales") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Sales</h1>
			<a href="/admin/finance" class="text-sm text-indigo-600 hover:underline whitespace-nowrap">Finance report →</a>
		</div>
		<div
			id="sales-filters"
			class="bg-white rounded-2xl shadow-sm p-4 mb-6 space-y-3"
			x-data={ salesFilterState(d) }
		>
			<!-- Hidden preset so the pager / reload-sales hx-include carries it too. -->
			<input type="hidden" name="preset" x-model="preset"/>
			<!-- Quick date presets -->
			<div class="flex flex-wrap gap-2">
				@salesPreset("today", "Today")
				@salesPreset("this-week", "This week")
				@salesPreset("this-month", "This month")
				@salesPreset("last-week", "Last week")
				@salesPreset("last-month", "Last month")
				@salesPreset("this-year", "This year")
			</div>
			<!-- Exact range + status + method + search -->
			<div class="flex flex-wrap items-end gap-3">
				<div>
					<label class="block text-xs text-slate-500 mb-1">From</label>
					<input type="date" name="from" x-model="from" x-on:change="preset=''; reload()" class="border rounded-lg px-3 py-2"/>
				</div>
				<div>
					<label class="block text-xs text-slate-500 mb-1">To</label>
					<input type="date" name="to" x-model="to" x-on:change="preset=''; reload()" class="border rounded-lg px-3 py-2"/>
				</div>
				<div>
					<label class="block text-xs text-slate-500 mb-1">Status</label>
					<select name="status" x-model="status" x-on:change="reload()" class="border rounded-lg px-3 py-2">
						<option value="">All</option>
						<option value="completed">Completed</option>
						<option value="credit">Credit</option>
						<option value="returned">Returned</option>
					</select>
				</div>
				<div>
					<label class="block text-xs text-slate-500 mb-1">Payment</label>
					<select name="method" x-model="method" x-on:change="reload()" class="border rounded-lg px-3 py-2">
						<option value="">Any</option>
						<option value="cash">Cash</option>
						<option value="card">Card</option>
						<option value="online">Online</option>
						<option value="wallet">Wallet</option>
					</select>
				</div>
				<div class="flex-1 min-w-[12rem]">
					<label class="block text-xs text-slate-500 mb-1">Search</label>
					<input type="search" name="q" x-model="q" x-on:input.debounce.300ms="reload()" placeholder="Receipt no / customer / phone" class="w-full border rounded-lg px-3 py-2"/>
				</div>
				<button type="button" x-on:click="clear()" class="px-4 py-2 rounded-lg border text-slate-600 hover:bg-slate-50">Clear</button>
			</div>
		</div>

		<div class="bg-white rounded-2xl shadow-sm p-6">
			<div id="sales-list" hx-get="/admin/sales/table" hx-trigger="reload-sales from:body" hx-include="#sales-filters" hx-swap="innerHTML">
				@SalesList(d)
			</div>
		</div>
	}
}

// salesFilterState seeds the Alpine filter model from the server-resolved values
// and reloads just the table (#sales-list) via HTMX whenever a filter changes, so
// presets highlight instantly and search is live — no full-page reload.
func salesFilterState(d SalesData) string {
	return "salesFilters(" +
		strconv.Quote(d.Preset) + "," + strconv.Quote(d.From) + "," + strconv.Quote(d.To) + "," +
		strconv.Quote(d.Status) + "," + strconv.Quote(d.Method) + "," + strconv.Quote(d.Query) + ")"
}

templ salesPreset(key, label string) {
	<button
		type="button"
		x-on:click={ "setPreset('" + key + "')" }
		x-bind:class={ "preset==='" + key + "' ? 'bg-indigo-600 text-white' : 'border text-slate-600 hover:bg-slate-50'" }
		class="px-3 py-1.5 rounded-lg text-sm"
	>{ label }</button>
}

// SalesList is the swappable region (table + pager).
templ SalesList(d SalesData) {
	<table class="w-full text-sm">
		<thead class="text-left text-slate-500 border-b">
			<tr>
				<th class="py-2 px-3">Receipt</th>
				<th class="py-2 px-3">When</th>
				<th class="py-2 px-3">Cashier</th>
				<th class="py-2 px-3">Customer</th>
				<th class="py-2 px-3">Type</th>
				<th class="py-2 px-3 text-right">Total</th>
				<th class="py-2 px-3 text-right">Paid</th>
				<th class="py-2 px-3 text-center">Status</th>
				<th class="py-2 px-3"></th>
			</tr>
		</thead>
		<tbody>
			@SalesRows(d.Rows, d.Symbol)
		</tbody>
	</table>
	@pager(d.Page, d.HasNext, "/admin/sales/table", "#sales-list", "#sales-filters")
}

templ SalesRows(rows []sales.Sale, symbol string) {
	if len(rows) == 0 {
		<tr><td colspan="9" class="py-6 text-center text-slate-500">No sales in this range.</td></tr>
	} else {
		for _, s := range rows {
			<tr class="border-b last:border-0">
				<td class="py-2 px-3 font-medium">
					<a class="text-indigo-600 hover:underline" href={ templ.SafeURL("/cashier/receipt/" + strconv.FormatInt(s.ID, 10)) }>{ s.ReceiptNo }</a>
				</td>
				<td class="py-2 px-3 text-slate-500">{ s.CreatedAt.Format("2006-01-02 15:04") }</td>
				<td class="py-2 px-3">{ s.CashierName }</td>
				<td class="py-2 px-3">{ customerOrWalkIn(s.CustomerName) }</td>
				<td class="py-2 px-3 capitalize">{ s.SaleType }</td>
				<td class="py-2 px-3 text-right">{ money.Format(symbol, s.Total) }</td>
				<td class="py-2 px-3 text-right">{ money.Format(symbol, s.PaidAmount) }</td>
				<td class="py-2 px-3 text-center">@statusBadge(s.Status)</td>
				<td class="py-2 px-3 text-right whitespace-nowrap">
					if s.Status != "returned" {
						<button
							class="text-rose-600 hover:underline"
							hx-get={ "/admin/sales/return/" + strconv.FormatInt(s.ID, 10) }
							hx-target="#modal-container"
							hx-swap="innerHTML"
						>Return</button>
					}
				</td>
			</tr>
		}
	}
}

templ salesStatusOption(value, label, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

// SaleReturnForm is the per-line partial-return modal. The Alpine saleReturn()
// component (app.js) collects quantities and posts to the API.
templ SaleReturnForm(d sales.Detail) {
	@modalShell("Return — " + d.Sale.ReceiptNo) {
		<form class="p-6 space-y-4" x-data={ "saleReturn(" + strconv.FormatInt(d.Sale.ID, 10) + ")" } x-on:submit.prevent="submit()">
			<p class="text-sm text-slate-500">Enter the quantity to return for each line (max = remaining).</p>
			<table class="w-full text-sm">
				<thead class="text-left text-slate-500 border-b">
					<tr><th class="py-1">Product</th><th class="py-1 text-right">Sold</th><th class="py-1 text-right">Returnable</th><th class="py-1 text-right w-28">Return qty</th><th class="py-1 text-right w-36">Goods</th></tr>
				</thead>
				<tbody>
					for _, it := range d.Items {
						if it.ReturnableQty().IsPositive() {
							<tr class="border-b last:border-0">
								<td class="py-1">{ ternary(it.Description != nil && *it.Description != "", strOrEmpty(it.Description), it.ProductName) }</td>
								<td class="py-1 text-right">{ money.Display(it.Quantity) } { it.UnitAbbr }</td>
								<td class="py-1 text-right">{ money.Display(it.ReturnableQty()) }</td>
								<td class="py-1 text-right">
									<input
										type="number" step="0.001" min="0"
										max={ it.ReturnableQty().String() }
										value="0"
										class="w-24 border rounded px-2 py-1 text-right"
										x-on:input={ "setQty(" + strconv.FormatInt(it.ID, 10) + ", $event.target.value, " + it.ReturnableQty().String() + ")" }
									/>
								</td>
								<td class="py-1 pl-4 text-right">
									<select
										class="w-full border rounded px-2 py-1 text-sm"
										x-on:change={ "setDispo(" + strconv.FormatInt(it.ID, 10) + ", $event.target.value)" }
									>
										<option value="restock">Back to stock</option>
										<option value="damage">Send to damage</option>
									</select>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
			<p class="text-xs text-slate-500">Pick "Send to damage" for faulty goods: the customer is still refunded, but the item is written off instead of put back on the shelf.</p>
			<div>
				<label class="block text-sm font-medium mb-1">Reason (optional)</label>
				<input x-model="reason" class="w-full border rounded-lg px-3 py-2" placeholder="damaged, wrong item…"/>
			</div>
			<div class="flex justify-end gap-3 pt-2">
				<button type="button" class="px-4 py-2 rounded-lg border" x-on:click="$dispatch('close-modal')">Cancel</button>
				<button type="submit" x-bind:disabled="busy" class="px-4 py-2 rounded-lg bg-rose-600 text-white disabled:opacity-40">Process Return</button>
			</div>
		</form>
	}
}

func customerOrWalkIn(name *string) string {
	if name == nil {
		return "Walk-in"
	}
	return *name
}
