package adminpages

import (
	"strconv"

	"karots-pos/internal/features/reports"
	"karots-pos/internal/features/sales"
	"karots-pos/internal/money"
	"karots-pos/internal/plugin"
	"karots-pos/templates/layouts"
	"karots-pos/templates/shared"

	"github.com/shopspring/decimal"
)

// DashboardData is the view model for the admin home.
type DashboardData struct {
	UserName       string
	Symbol         string
	TodayCount     int
	TodayTotal     decimal.Decimal
	LowStockCount  int
	ExpiringCount  int
	OutstandingDue decimal.Decimal
	ReviewCount    int
	Recent         []sales.Sale
	Charts         DashboardChartsData // the interactive chart carousel (range-switchable)
	Setup          []SetupStep         // onboarding checklist; shown only while incomplete
}

// DashboardChartsData feeds the range-switchable chart carousel on the home page.
// It is rendered both inside the full Dashboard and on its own by DashboardCharts
// (the HTMX fragment a range button swaps in), so the charts reuse exactly the
// same report queries the reports section runs.
type DashboardChartsData struct {
	Symbol   string
	Days     int // active range: 7 / 14 / 30 / 90
	Trend    []reports.DayRow
	Pay      []reports.MethodTotal
	Top      []reports.ProductRevenue
	Cashiers []reports.CashierSalesRow
	Cats     []reports.CategoryProfit
	Expenses []reports.ExpenseCatRow
}

templ Dashboard(d DashboardData) {
	@layouts.Admin("Dashboard", d.UserName, "dashboard") {
		<h1 class="text-2xl font-bold mb-6">Dashboard</h1>
		if len(d.Setup) > 0 && DoneCount(d.Setup) < len(d.Setup) {
			@SetupChecklist(d.Setup, true)
		}
		if d.ReviewCount > 0 {
			<a href="/admin/products/review" class="flex items-center gap-3 mb-6 px-5 py-4 rounded-2xl bg-amber-50 border border-amber-300 text-amber-900 hover:bg-amber-100 transition">
				<span class="text-2xl">⚠️</span>
				<div class="flex-1">
					<div class="font-semibold">
						{ strconv.Itoa(d.ReviewCount) }
						if d.ReviewCount == 1 {
							item needs review
						} else {
							items need review
						}
					</div>
					<div class="text-sm text-amber-800">Quick-added at the till — set their category, cost and stock count. Their profit figures aren't accurate until finished.</div>
				</div>
				<span class="text-sm font-medium">Review now →</span>
			</a>
		}
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
			@statCardLink("Today's Sales", strconv.Itoa(d.TodayCount), "indigo", "/admin/sales?preset=today")
			@statCardLink("Today's Revenue", money.Format(d.Symbol, d.TodayTotal), "emerald", "/admin/finance")
			@statCardLink("Low Stock Items", strconv.Itoa(d.LowStockCount), "amber", "/admin/reports/low-stock")
			@statCardLink("Expiring Soon", strconv.Itoa(d.ExpiringCount), "rose", "/admin/reports/batches?days=30")
			@statCardLink("Customer Dues", money.Format(d.Symbol, d.OutstandingDue), "rose", "/admin/customers")
		</div>

		<!-- Trends — the reports section's charts, surfaced on the home page,
		     with a range switcher and a carousel to page through more graphs. -->
		<div class="mb-8">
			@DashboardCharts(d.Charts)
		</div>

		@OpenTillCard()

		if cards := plugin.DashboardCards(); len(cards) > 0 {
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
				for _, c := range cards {
					@c.Component
				}
			</div>
		}

		<div class="bg-white rounded-2xl shadow-sm p-6">
			@chartHead("Recent sales", "/admin/reports/finance", "All sales")
			if len(d.Recent) == 0 {
				<p class="text-slate-500">No sales yet today.</p>
			} else {
				<table class="w-full text-sm">
					<thead class="text-left text-slate-500 border-b">
						<tr>
							<th class="py-2 pr-4">Receipt</th>
							<th class="py-2 pr-4">Cashier</th>
							<th class="py-2 pr-4">Type</th>
							<th class="py-2 pr-8 text-right">Total</th>
							<th class="py-2 text-right">Status</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range d.Recent {
							<tr class="border-b last:border-0">
								<td class="py-2 pr-4 font-medium">{ s.ReceiptNo }</td>
								<td class="py-2 pr-4">{ s.CashierName }</td>
								<td class="py-2 pr-4 capitalize">{ s.SaleType }</td>
								<td class="py-2 pr-8 text-right">{ money.Format(d.Symbol, s.Total) }</td>
								<td class="py-2 text-right">@statusBadge(s.Status)</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	}
}

// DashboardCharts is the range-switchable chart carousel — rendered inside the
// full Dashboard and swapped on its own when a range button is clicked. The
// wrapping id lets the range buttons hx-swap this whole block; the Alpine slide
// state pages through the chart panels so we can surface several graphs without
// crowding the page.
templ DashboardCharts(d DashboardChartsData) {
	<div id="dash-charts" x-data="{ slide: 0, total: 3 }">
		<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
			<div class="inline-flex rounded-lg border border-slate-200 overflow-hidden text-sm">
				@rangeBtn(7, d.Days)
				@rangeBtn(14, d.Days)
				@rangeBtn(30, d.Days)
				@rangeBtn(90, d.Days)
			</div>
			<div class="flex items-center gap-3">
				<button type="button" x-on:click="slide=(slide-1+total)%total" class="w-8 h-8 rounded-full border border-slate-200 text-slate-500 hover:bg-slate-100 flex items-center justify-center">‹</button>
				<div class="flex gap-1.5">
					<template x-for="i in total" x-bind:key="i">
						<button type="button" x-on:click="slide=i-1" x-bind:class="slide===i-1 ? 'bg-indigo-600' : 'bg-slate-300'" class="w-2.5 h-2.5 rounded-full transition"></button>
					</template>
				</div>
				<button type="button" x-on:click="slide=(slide+1)%total" class="w-8 h-8 rounded-full border border-slate-200 text-slate-500 hover:bg-slate-100 flex items-center justify-center">›</button>
			</div>
		</div>
		<!-- Slide 1 — revenue trend + payment mix -->
		<div x-show="slide===0" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<div class="lg:col-span-2">
				@shared.ChartCard("") {
					@chartHead(rangeTitle("Revenue & profit", d.Days), "/admin/finance", "Finance")
					{{ labels, series := trendChartData(d.Trend, d.Symbol, granOf(d.Days)) }}
					@shared.LineChart(labels, series)
				}
			</div>
			@shared.ChartCard("") {
				@chartHead(rangeTitle("Payments", d.Days), "/admin/reports/tender", "Report")
				@shared.Donut(paymentSlices(d.Pay, d.Symbol))
			}
		</div>
		<!-- Slide 2 — top products + sales by cashier -->
		<div x-show="slide===1" x-cloak class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			@shared.ChartCard("") {
				@chartHead(rangeTitle("Top products", d.Days), "/admin/reports/top-products", "Report")
				@shared.HBarChart(topBars(d.Top, d.Symbol))
			}
			@shared.ChartCard("") {
				@chartHead(rangeTitle("Sales by cashier", d.Days), "/admin/reports/finance", "Report")
				@shared.HBarChart(cashierBars(d.Cashiers, d.Symbol))
			}
		</div>
		<!-- Slide 3 — profit + expenses by category -->
		<div x-show="slide===2" x-cloak class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			@shared.ChartCard("") {
				@chartHead(rangeTitle("Profit by category", d.Days), "/admin/finance/profit", "Finance")
				@shared.HBarChart(catBars(d.Cats, d.Symbol))
			}
			@shared.ChartCard("") {
				@chartHead(rangeTitle("Expenses by category", d.Days), "/admin/reports/finance", "Report")
				@shared.HBarChart(expenseBars(d.Expenses, d.Symbol))
			}
		</div>
	</div>
}

// rangeBtn is one range-switch pill; clicking it swaps the whole chart block for
// that window over HTMX (no full-page reload).
templ rangeBtn(days, current int) {
	<button
		type="button"
		hx-get={ "/admin/dashboard/charts?days=" + strconv.Itoa(days) }
		hx-target="#dash-charts"
		hx-swap="outerHTML"
		class={ "px-3 py-1.5 border-r border-slate-200 last:border-r-0 " + rangeCls(days == current) }
	>{ strconv.Itoa(days) }d</button>
}

func rangeCls(active bool) string {
	if active {
		return "bg-indigo-600 text-white font-medium"
	}
	return "text-slate-600 hover:bg-slate-100"
}

// granOf groups by day for short windows and by week once a daily line would get
// too dense to read.
func granOf(days int) string {
	if days > 31 {
		return "week"
	}
	return "day"
}

func rangeTitle(base string, days int) string {
	return base + " — last " + strconv.Itoa(days) + " days"
}

// cashierBars / expenseBars turn report rows into horizontal bars, mirroring the
// finance page's helpers.
func cashierBars(rows []reports.CashierSalesRow, symbol string) []shared.ChartBar {
	bars := make([]shared.ChartBar, 0, len(rows))
	for _, r := range rows {
		bars = append(bars, shared.ChartBar{Label: r.Cashier, Value: r.Net.InexactFloat64(), Text: money.Format(symbol, r.Net)})
	}
	return bars
}

func expenseBars(rows []reports.ExpenseCatRow, symbol string) []shared.ChartBar {
	bars := make([]shared.ChartBar, 0, len(rows))
	for _, r := range rows {
		bars = append(bars, shared.ChartBar{Label: r.Category, Value: r.Total.InexactFloat64(), Text: money.Format(symbol, r.Total)})
	}
	return bars
}

// chartHead is a card header with a title on the left and a "drill into the full
// report" link on the right, tying each dashboard panel to its reports page.
templ chartHead(title, href, link string) {
	<div class="flex items-center justify-between mb-4">
		<h2 class="text-lg font-semibold">{ title }</h2>
		<a href={ templ.SafeURL(href) } class="text-sm text-indigo-600 hover:underline whitespace-nowrap">{ link } →</a>
	</div>
}

// topBars turns the top-products revenue rows into horizontal bars (max 6, the
// dashboard is a glance — the full ranking is one click away in the report).
func topBars(rows []reports.ProductRevenue, symbol string) []shared.ChartBar {
	if len(rows) > 6 {
		rows = rows[:6]
	}
	bars := make([]shared.ChartBar, 0, len(rows))
	for _, p := range rows {
		bars = append(bars, shared.ChartBar{
			Label: p.ProductName,
			Value: p.Revenue.InexactFloat64(),
			Text:  money.Format(symbol, p.Revenue),
		})
	}
	return bars
}

// OpenTillCard is the sell action on the dashboard: opening a cashier session on
// an admin account is unusual (it's the counter's job and starts a drawer on the
// admin), so it lives here as a card — off the sidebar where it was mis-clicked —
// behind a red in-app confirmation.
templ OpenTillCard() {
	<div x-data="{ warn: false }" class="mb-8">
		<div class="bg-white rounded-2xl shadow-sm p-6 flex items-center justify-between gap-4">
			<div>
				<h2 class="text-lg font-semibold">Sell at the counter</h2>
				<p class="text-sm text-slate-500">Opens a cashier session (the till) on your account.</p>
			</div>
			<button type="button" x-on:click="warn = true" class="px-4 py-2.5 rounded-lg bg-indigo-600 text-white font-semibold hover:bg-indigo-700">🧾 Open Cashier Till</button>
		</div>
		<!-- Red confirmation: admins don't usually run the till. -->
		<div x-show="warn" x-cloak class="fixed inset-0 bg-black/40 flex items-center justify-center z-40 p-4" x-on:keydown.escape.window="warn = false">
			<div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
				<div class="px-6 py-4 bg-rose-600 text-white">
					<h3 class="text-lg font-semibold">⚠️ Open the cashier till?</h3>
				</div>
				<div class="px-6 py-4 space-y-3">
					<p class="text-sm text-slate-700">
						Running the till is normally the cashier's job. This starts a cashier
						session (a cash drawer) on <b>your</b> account and takes you to the sell screen.
					</p>
					<p class="text-sm text-slate-500">Only continue if you really mean to sell at the counter.</p>
					<div class="flex justify-end gap-3 pt-1">
						<button type="button" x-on:click="warn = false" class="px-4 py-2 rounded-lg border">Cancel</button>
						<a href="/cashier" class="px-4 py-2 rounded-lg bg-rose-600 text-white font-medium">Continue anyway →</a>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ statCard(label, value, color string) {
	<div class="bg-white rounded-2xl shadow-sm p-5">
		<div class="text-sm text-slate-500">{ label }</div>
		<div class={ "text-2xl font-bold mt-1 text-" + color + "-600" }>{ value }</div>
	</div>
}

templ statCardLink(label, value, color, href string) {
	<a href={ templ.SafeURL(href) } class="block bg-white rounded-2xl shadow-sm p-5 hover:ring-2 hover:ring-indigo-300 transition">
		<div class="text-sm text-slate-500">{ label }</div>
		<div class={ "text-2xl font-bold mt-1 text-" + color + "-600" }>{ value }</div>
	</a>
}

templ statusBadge(status string) {
	switch status {
		case "completed":
			<span class="px-2 py-0.5 rounded-full text-xs bg-emerald-100 text-emerald-700">completed</span>
		case "credit":
			<span class="px-2 py-0.5 rounded-full text-xs bg-amber-100 text-amber-700">credit</span>
		case "returned":
			<span class="px-2 py-0.5 rounded-full text-xs bg-slate-200 text-slate-700">returned</span>
		case "partially_returned":
			<span class="px-2 py-0.5 rounded-full text-xs bg-orange-100 text-orange-700">part. returned</span>
		default:
			<span class="px-2 py-0.5 rounded-full text-xs bg-slate-200 text-slate-700">{ status }</span>
	}
}
