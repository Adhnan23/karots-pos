package adminpages

import (
	"fmt"
	"sort"
	"strconv"
	"time"

	"karots-pos/internal/features/recovery"
	"karots-pos/internal/features/reports"
	"karots-pos/internal/money"
	"karots-pos/templates/layouts"
	"karots-pos/templates/shared"

	"github.com/shopspring/decimal"
)

// productChartData builds the x labels + this-year/last-year unit series for the
// per-product graph. Last-year periods are shifted +1 year so they line up with
// the same calendar period this year; missing periods plot as 0.
func productChartData(rows, lastYear []reports.ProductPeriodRow, gran string) ([]string, []shared.LineSeries) {
	curByKey := map[string]float64{}
	lyByKey := map[string]float64{}
	keys := map[string]time.Time{}
	key := func(t time.Time) string { return t.Format("2006-01-02") }
	for _, r := range rows {
		k := key(r.Day)
		curByKey[k] = r.Qty.InexactFloat64()
		keys[k] = r.Day
	}
	for _, r := range lastYear {
		shifted := r.Day.AddDate(1, 0, 0)
		k := key(shifted)
		lyByKey[k] = r.Qty.InexactFloat64()
		if _, ok := keys[k]; !ok {
			keys[k] = shifted
		}
	}
	sorted := make([]time.Time, 0, len(keys))
	for _, t := range keys {
		sorted = append(sorted, t)
	}
	sort.Slice(sorted, func(i, j int) bool { return sorted[i].Before(sorted[j]) })
	labels := make([]string, 0, len(sorted))
	cur := make([]float64, 0, len(sorted))
	ly := make([]float64, 0, len(sorted))
	for _, t := range sorted {
		k := key(t)
		labels = append(labels, periodLabel(t, gran))
		cur = append(cur, curByKey[k])
		ly = append(ly, lyByKey[k])
	}
	return labels, []shared.LineSeries{
		{Name: "This period", Color: shared.Palette[0], Values: cur},
		{Name: "Last year", Color: shared.Palette[3], Values: ly},
	}
}

// containsStr reports whether xs contains v.
func containsStr(xs []string, v string) bool {
	for _, x := range xs {
		if x == v {
			return true
		}
	}
	return false
}

// catFilterLabel summarises the selected-category set for the dropdown summary.
func catFilterLabel(sel []string) string {
	switch len(sel) {
	case 0:
		return "All categories"
	case 1:
		return sel[0]
	default:
		return strconv.Itoa(len(sel)) + " selected"
	}
}

// catBars builds horizontal-bar chart input (profit per category) for the chart.
// catBars maps category rows to horizontal-bar chart data (used by the Finance
// and dashboard summaries; Profit by Category uses in-row bars instead).
func catBars(rows []reports.CategoryProfit, symbol string) []shared.ChartBar {
	bars := make([]shared.ChartBar, 0, len(rows))
	for _, r := range rows {
		bars = append(bars, shared.ChartBar{
			Label: r.Category,
			Value: r.Profit.InexactFloat64(),
			Text:  money.Format(symbol, r.Profit),
		})
	}
	return bars
}

// trendChartData builds the x labels + revenue/profit line series for the trend.
func trendChartData(rows []reports.DayRow, symbol, gran string) ([]string, []shared.LineSeries) {
	labels := make([]string, 0, len(rows))
	var rev, prof []float64
	for _, r := range rows {
		labels = append(labels, periodLabel(r.Day, gran))
		rev = append(rev, r.Revenue.InexactFloat64())
		prof = append(prof, r.Profit.InexactFloat64())
	}
	return labels, []shared.LineSeries{
		{Name: "Net revenue", Color: shared.Palette[0], Values: rev},
		{Name: "Profit", Color: shared.Palette[1], Values: prof},
	}
}

// periodLabel formats a period-start date for the chart x-axis given the
// grouping granularity (month → "Jan 2006", day/week → short date).
func periodLabel(t time.Time, gran string) string {
	if gran == "month" {
		return t.Format("Jan 2006")
	}
	return t.Format("Jan 02")
}

// ============================ Returns / refunds report ============================

// ReturnProductRow is one product in the "most returned" breakdown, with the
// in-row bar (share of the worst offender's refund value) and share of total.
type ReturnProductRow struct {
	Name             string
	Qty, Refund      decimal.Decimal
	BarPct, SharePct float64
}

type ReturnsReportData struct {
	ShopName, Symbol, From, To, Preset string
	Rows                               []reports.ReturnRow
	TopProducts                        []ReturnProductRow
	TotalRefund, TotalQty              decimal.Decimal
	Receipts                           int
	// TotalRefund/TotalQty/Receipts cover the whole range; Rows is page Page of Total rows.
	Total, Page, PageSize int
}

templ ReturnsReport(d ReturnsReportData) {
	@layouts.Report("Returns / Refunds", d.ShopName) {
		@rptRangeForm("/admin/reports/returns", d.Preset, d.From, d.To) {
			<a
				class="no-print px-4 py-1.5 rounded-lg border text-sm"
				href={ templ.SafeURL("/admin/reports/returns?format=csv&from=" + d.From + "&to=" + d.To) }
			>Download CSV</a>
		}
		@rptPeriodLine(d.From, d.To)
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
			@kpiCard("Refunded", money.Format(d.Symbol, d.TotalRefund))
			@kpiCard("Returned lines", strconv.Itoa(d.Total))
			@kpiCard("Units returned", money.Display(d.TotalQty))
			@kpiCard("Receipts affected", strconv.Itoa(d.Receipts))
		</div>
		if len(d.TopProducts) > 0 {
			<div class="bg-white rounded-2xl shadow-sm p-4 mb-6">
				<div class="text-xs text-slate-500 mb-3">Most returned products — chase quality or supplier issues here</div>
				<table class="w-full text-sm">
					<tbody>
						for _, r := range d.TopProducts {
							<tr class="border-b last:border-0">
								<td class="py-1.5 w-1/2">
									<div class="font-medium">{ r.Name }</div>
									<div class="mt-1 h-1.5 rounded bg-rose-100">
										<div class="h-1.5 rounded bg-rose-500" style={ barWidth(r.BarPct) }></div>
									</div>
								</td>
								<td class="py-1.5 text-right align-top text-slate-500">{ money.Display(r.Qty) } units</td>
								<td class="py-1.5 text-right align-top">{ money.Format(d.Symbol, r.Refund) }</td>
								<td class="py-1.5 text-right align-top text-slate-500 w-16">{ fmtPct1(r.SharePct) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="text-xs text-slate-500 mb-2">All returned lines</div>
		<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Date</th><th class="py-1.5">Receipt</th><th class="py-1.5">Product</th><th class="py-1.5">Customer</th><th class="py-1.5 text-right">Qty</th><th class="py-1.5 text-right">Refund</th></tr>
			</thead>
			<tbody>
				for _, r := range d.Rows {
					<tr class="border-b last:border-0">
						<td class="py-1.5 text-slate-500">{ r.SaleDate.Format("2006-01-02 15:04") }</td>
						<td class="py-1.5 font-medium">{ r.ReceiptNo }</td>
						<td class="py-1.5">{ r.ProductName }</td>
						<td class="py-1.5 text-slate-500">{ strOrDashAdmin(r.Customer) }</td>
						<td class="py-1.5 text-right">{ money.Display(r.Qty) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.RefundValue) }</td>
					</tr>
				}
				if len(d.Rows) == 0 {
					<tr><td colspan="6" class="py-6 text-center text-slate-400">No returns in this period.</td></tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr><td class="py-2" colspan="5">Total refunded (all { strconv.Itoa(d.Total) })</td><td class="py-2 text-right">{ money.Format(d.Symbol, d.TotalRefund) }</td></tr>
			</tfoot>
		</table>
		@rptTruncNote(len(d.Rows), d.Total)
		@rptPager(rangeQuery(d.Preset, d.From, d.To), d.Page, d.PageSize, d.Total)
	}
}

// ============================ Profit by category ============================

// CategoryProfitRow is one category with the derived margin and the in-row bar
// (share of the top category's profit).
type CategoryProfitRow struct {
	R      reports.CategoryProfit
	Margin float64
	BarPct float64
}

type CategoryProfitData struct {
	ShopName, Symbol, From, To, Preset string
	Rows                               []CategoryProfitRow
	TotalRevenue, TotalProfit          decimal.Decimal
	TotalMargin                        float64
	AllCats                            []string
	SelCats                            []string
}

templ ProfitByCategoryReport(d CategoryProfitData) {
	@layouts.Report("Profit by Category", d.ShopName) {
		@rptRangeForm("/admin/reports/profit-by-category", d.Preset, d.From, d.To) {
			<a
				class="no-print px-4 py-1.5 rounded-lg border text-sm"
				href={ templ.SafeURL("/admin/reports/profit-by-category?format=csv&from=" + d.From + "&to=" + d.To) }
			>Download CSV</a>
			<div>
				<label class="block text-xs text-slate-500 mb-1">Categories</label>
				<details class="relative">
					<summary class="border rounded-lg px-3 py-1.5 cursor-pointer select-none text-sm list-none">
						{ catFilterLabel(d.SelCats) }
					</summary>
					<div class="absolute z-10 mt-1 bg-white border rounded-lg shadow-lg p-2 max-h-64 overflow-auto w-56">
						for _, name := range d.AllCats {
							<label class="flex items-center gap-2 px-2 py-1 text-sm hover:bg-slate-50 rounded">
								<input type="checkbox" name="category" value={ name } checked?={ containsStr(d.SelCats, name) }/>
								<span>{ name }</span>
							</label>
						}
					</div>
				</details>
			</div>
		}
		@rptPeriodLine(d.From, d.To)
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
			@kpiCard("Categories", strconv.Itoa(len(d.Rows)))
			@kpiCard("Net revenue", money.Format(d.Symbol, d.TotalRevenue))
			@kpiCard("Profit", money.Format(d.Symbol, d.TotalProfit))
			@kpiCard("Margin", fmtPct1(d.TotalMargin))
		</div>
		<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Category</th><th class="py-1.5 text-right">Net revenue</th><th class="py-1.5 text-right">COGS</th><th class="py-1.5 text-right">Profit</th><th class="py-1.5 text-right">Margin</th></tr>
			</thead>
			<tbody>
				for _, r := range d.Rows {
					<tr class="border-b last:border-0">
						<td class="py-1.5">
							<div class="font-medium">{ r.R.Category }</div>
							<div class="mt-1 h-1.5 rounded bg-emerald-100">
								<div class="h-1.5 rounded bg-emerald-500" style={ barWidth(r.BarPct) }></div>
							</div>
						</td>
						<td class="py-1.5 text-right align-top">{ money.Format(d.Symbol, r.R.Revenue) }</td>
						<td class="py-1.5 text-right align-top">{ money.Format(d.Symbol, r.R.COGS) }</td>
						<td class="py-1.5 text-right align-top">
							if r.R.Profit.IsNegative() {
								<span class="text-rose-600">{ money.Format(d.Symbol, r.R.Profit) }</span>
							} else {
								{ money.Format(d.Symbol, r.R.Profit) }
							}
						</td>
						<td class="py-1.5 text-right align-top">{ fmtPct1(r.Margin) }</td>
					</tr>
				}
				if len(d.Rows) == 0 {
					<tr><td colspan="5" class="py-6 text-center text-slate-400">No sales in this period.</td></tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr>
					<td class="py-2">Total</td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.TotalRevenue) }</td>
					<td class="py-2"></td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.TotalProfit) }</td>
					<td class="py-2 text-right">{ fmtPct1(d.TotalMargin) }</td>
				</tr>
			</tfoot>
		</table>
	}
}

// ============================ Daily sales trend ============================

type SalesTrendData struct {
	ShopName, Symbol, From, To, Preset      string
	Group                                   string
	Rows                                    []reports.DayRow
	TotalRevenue, TotalProfit, MaxRevenue   decimal.Decimal
}

templ SalesTrendReport(d SalesTrendData) {
	@layouts.Report("Sales Trend", d.ShopName) {
		@rptRangeForm("/admin/reports/sales-trend", d.Preset, d.From, d.To) {
			<a
				class="no-print px-4 py-1.5 rounded-lg border text-sm"
				href={ templ.SafeURL("/admin/reports/sales-trend?format=csv&group=" + d.Group + "&from=" + d.From + "&to=" + d.To) }
			>Download CSV</a>
			<div>
				<label class="block text-xs text-slate-500 mb-1">Group by</label>
				<select name="group" class="border rounded-lg px-3 py-1.5">
					@statusOpt("day", "Day", d.Group)
					@statusOpt("week", "Week", d.Group)
					@statusOpt("month", "Month", d.Group)
				</select>
			</div>
		}
		@rptPeriodLine(d.From, d.To)
		if len(d.Rows) > 0 {
			<div class="mb-6">
				{{ labels, series := trendChartData(d.Rows, d.Symbol, d.Group) }}
				@shared.LineChart(labels, series)
			</div>
		}
		<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Period</th><th class="py-1.5 text-right">Sales</th><th class="py-1.5 text-right">Net revenue</th><th class="py-1.5 text-right">Profit</th><th class="py-1.5 w-1/3">&nbsp;</th></tr>
			</thead>
			<tbody>
				for _, r := range d.Rows {
					<tr class="border-b last:border-0">
						<td class="py-1.5 font-medium">{ periodLabel(r.Day, d.Group) }</td>
						<td class="py-1.5 text-right">{ strconv.Itoa(r.Count) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.Revenue) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.Profit) }</td>
						<td class="py-1.5">
							<div class="bg-slate-100 rounded h-3">
								<div class="bg-indigo-500 h-3 rounded" style={ "width:" + pctOf(r.Revenue, d.MaxRevenue) + "%" }></div>
							</div>
						</td>
					</tr>
				}
				if len(d.Rows) == 0 {
					<tr><td colspan="5" class="py-6 text-center text-slate-400">No sales in this period.</td></tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr>
					<td class="py-2">Total</td>
					<td class="py-2"></td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.TotalRevenue) }</td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.TotalProfit) }</td>
					<td class="py-2"></td>
				</tr>
			</tfoot>
		</table>
	}
}

// ============================ Warranty & recovery ============================

type WarrantyReportData struct {
	ShopName, Symbol, From, To, Preset string
	Summary                    reports.WarrantySummary
}

templ WarrantyReport(d WarrantyReportData) {
	@layouts.Report("Warranty & Recovery", d.ShopName) {
		@rptRangeForm("/admin/reports/warranty", d.Preset, d.From, d.To) {
		}
		@rptPeriodLine(d.From, d.To)
		<h3 class="font-semibold mb-2">Stock losses</h3>
		<table class="w-full text-sm mb-6">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Type</th><th class="py-1.5 text-right">Count</th><th class="py-1.5 text-right">Worth</th></tr>
			</thead>
			<tbody>
				<tr class="border-b"><td class="py-1.5">Warranty replacements</td><td class="py-1.5 text-right">{ strconv.Itoa(d.Summary.ReplacementCount) }</td><td class="py-1.5 text-right">{ money.Format(d.Symbol, d.Summary.ReplacementCost) }</td></tr>
				<tr class="border-b"><td class="py-1.5">Damage write-offs</td><td class="py-1.5 text-right">{ strconv.Itoa(d.Summary.DamageCount) }</td><td class="py-1.5 text-right">{ money.Format(d.Symbol, d.Summary.DamageCost) }</td></tr>
			</tbody>
		</table>
		<h3 class="font-semibold mb-2">Supplier recoveries</h3>
		<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Outcome</th><th class="py-1.5 text-right">Count</th><th class="py-1.5 text-right">Loss value</th><th class="py-1.5 text-right">Recovered</th></tr>
			</thead>
			<tbody>
				for _, r := range d.Summary.Recoveries {
					<tr class="border-b last:border-0">
						<td class="py-1.5 capitalize">{ r.Outcome }</td>
						<td class="py-1.5 text-right">{ strconv.Itoa(r.Count) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.LossValue) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.Recovered) }</td>
					</tr>
				}
				if len(d.Summary.Recoveries) == 0 {
					<tr><td colspan="4" class="py-6 text-center text-slate-400">No recoveries in this period.</td></tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr><td class="py-2" colspan="3">Total recovered</td><td class="py-2 text-right">{ money.Format(d.Symbol, d.Summary.RecoveredValue) }</td></tr>
			</tfoot>
		</table>
	}
}

// ======================== Losses & Recovery (merged) ========================

// LossesReportData merges the range-scoped warranty/damage summary with the
// actionable damage write-off detail (formerly two separate reports).
type LossesReportData struct {
	ShopName, UserName, Base, Symbol, From, To, Preset string
	Summary                                            reports.WarrantySummary
	Losses                                             []recovery.DamageLoss
}

templ LossesReport(d LossesReportData) {
	@layouts.Report("Losses & Recovery", d.ShopName) {
		@rptRangeForm("/admin/reports/losses", d.Preset, d.From, d.To) {
		}
		@rptPeriodLine(d.From, d.To)
		<h3 class="font-semibold mb-2">Stock losses</h3>
		<table class="w-full text-sm mb-6">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Type</th><th class="py-1.5 text-right">Count</th><th class="py-1.5 text-right">Worth</th></tr>
			</thead>
			<tbody>
				<tr class="border-b"><td class="py-1.5">Warranty replacements</td><td class="py-1.5 text-right">{ strconv.Itoa(d.Summary.ReplacementCount) }</td><td class="py-1.5 text-right">{ money.Format(d.Symbol, d.Summary.ReplacementCost) }</td></tr>
				<tr class="border-b"><td class="py-1.5">Damage write-offs</td><td class="py-1.5 text-right">{ strconv.Itoa(d.Summary.DamageCount) }</td><td class="py-1.5 text-right">{ money.Format(d.Symbol, d.Summary.DamageCost) }</td></tr>
			</tbody>
		</table>
		<h3 class="font-semibold mb-2">Supplier recoveries</h3>
		<table class="w-full text-sm mb-8">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Outcome</th><th class="py-1.5 text-right">Count</th><th class="py-1.5 text-right">Loss value</th><th class="py-1.5 text-right">Recovered</th></tr>
			</thead>
			<tbody>
				for _, r := range d.Summary.Recoveries {
					<tr class="border-b last:border-0">
						<td class="py-1.5 capitalize">{ r.Outcome }</td>
						<td class="py-1.5 text-right">{ strconv.Itoa(r.Count) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.LossValue) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.Recovered) }</td>
					</tr>
				}
				if len(d.Summary.Recoveries) == 0 {
					<tr><td colspan="4" class="py-6 text-center text-slate-400">No recoveries in this period.</td></tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr><td class="py-2" colspan="3">Total recovered</td><td class="py-2 text-right">{ money.Format(d.Symbol, d.Summary.RecoveredValue) }</td></tr>
			</tfoot>
		</table>
		<div class="no-print">
			<h3 class="font-semibold mb-2">Damage write-off detail</h3>
			<p class="text-sm text-slate-500 mb-3">Each write-off and any value reclaimed from the supplier.</p>
			<div id="recovery-slot" class="mb-4"></div>
			<div
				id="damage-list"
				hx-get={ d.Base + "/damage/table" }
				hx-trigger="reload-damage from:body"
				hx-swap="innerHTML"
			>
				@DamageTable(DamageReportData{Symbol: d.Symbol, Base: d.Base, Losses: d.Losses})
			</div>
		</div>
	}
}

// ============================ Peak Hours ============================

type PeakCell struct {
	Count   int
	Revenue decimal.Decimal
}

type PeakHoursData struct {
	ShopName, Symbol, From, To, Preset string
	Grid                               [7][24]PeakCell
	HourTotals                         [24]PeakCell
	DayTotals                          [7]PeakCell
	MaxCount                           int
	TotalCount                         int
	TotalRevenue                       decimal.Decimal
	BusiestLabel                       string
}

templ PeakHoursReport(d PeakHoursData) {
	@layouts.Report("Peak Hours", d.ShopName) {
		@rptRangeForm("/admin/reports/peak-hours", d.Preset, d.From, d.To) {
			<a
				class="no-print px-4 py-1.5 rounded-lg border text-sm"
				href={ templ.SafeURL("/admin/reports/peak-hours?format=csv&from=" + d.From + "&to=" + d.To) }
			>Download CSV</a>
		}
		@rptPeriodLine(d.From, d.To)
		<div class="flex flex-wrap gap-6 mb-4 text-sm">
			if d.BusiestLabel != "" {
				<div>Busiest: <span class="font-semibold text-indigo-700">{ d.BusiestLabel }</span></div>
			}
			<div>Total sales: <span class="font-semibold">{ strconv.Itoa(d.TotalCount) }</span></div>
			<div>Total revenue: <span class="font-semibold">{ money.Format(d.Symbol, d.TotalRevenue) }</span></div>
		</div>
		<p class="text-xs text-slate-500 mb-3 no-print">Darker = more sales in that hour. Hover a cell for its takings. Times are the shop's local clock.</p>
		<div class="overflow-x-auto">
			<table class="text-xs border-collapse">
				<thead>
					<tr>
						<th class="p-1 sticky left-0 bg-white"></th>
						for h := 0; h < 24; h++ {
							<th class="p-1 text-slate-400 font-normal text-center w-8">{ fmt.Sprintf("%02d", h) }</th>
						}
						<th class="p-1 text-slate-500 text-right pl-2">Total</th>
					</tr>
				</thead>
				<tbody>
					for dow := 0; dow < 7; dow++ {
						<tr>
							<td class="p-1 pr-2 font-medium text-slate-600 sticky left-0 bg-white">{ WeekdayName(dow) }</td>
							for h := 0; h < 24; h++ {
								@peakCell(d.Grid[dow][h], d.MaxCount, d.Symbol)
							}
							<td class="p-1 pl-2 text-right font-semibold">{ strconv.Itoa(d.DayTotals[dow].Count) }</td>
						</tr>
					}
				</tbody>
				<tfoot class="border-t-2 font-semibold">
					<tr>
						<td class="p-1 pr-2 sticky left-0 bg-white">Total</td>
						for h := 0; h < 24; h++ {
							<td class="p-1 text-center text-slate-600">{ strconv.Itoa(d.HourTotals[h].Count) }</td>
						}
						<td class="p-1 pl-2 text-right">{ strconv.Itoa(d.TotalCount) }</td>
					</tr>
				</tfoot>
			</table>
		</div>
	}
}

templ peakCell(cell PeakCell, max int, symbol string) {
	if cell.Count == 0 {
		<td class="p-1 text-center text-slate-300 border border-slate-100">·</td>
	} else {
		<td
			class={ "p-1 text-center border border-slate-100 " + peakTextClass(cell.Count, max) }
			style={ peakBgStyle(cell.Count, max) }
			title={ money.Format(symbol, cell.Revenue) }
		>{ strconv.Itoa(cell.Count) }</td>
	}
}

// WeekdayName maps Postgres DOW (0=Sunday) to a short label.
func WeekdayName(dow int) string {
	names := []string{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}
	if dow < 0 || dow > 6 {
		return "?"
	}
	return names[dow]
}

// peakBgStyle shades a heatmap cell indigo by its share of the busiest cell.
func peakBgStyle(count, max int) string {
	alpha := 0.15
	if max > 0 {
		alpha = 0.15 + 0.85*float64(count)/float64(max)
	}
	return "background-color: rgba(79,70,229," + strconv.FormatFloat(alpha, 'f', 2, 64) + ")"
}

// peakTextClass keeps the number readable: white on the darker (hot) cells.
func peakTextClass(count, max int) string {
	if max > 0 && float64(count)/float64(max) > 0.5 {
		return "text-white"
	}
	return "text-slate-700"
}

// pctOf returns part/whole as a rounded whole-number percent string (0 when whole<=0).
func pctOf(part, whole decimal.Decimal) string {
	if !whole.IsPositive() {
		return "0"
	}
	return part.Div(whole).Mul(decimal.NewFromInt(100)).Round(0).String()
}

// ============================ Per-product sales report ============================

type ProductSalesData struct {
	ShopName, Symbol, From, To, Preset, Group string
	ProductID                                 int64
	ProductName                               string
	Rows, LastYear                            []reports.ProductPeriodRow
	TotalQty, TotalRevenue                    decimal.Decimal
}

templ ProductSalesReport(d ProductSalesData) {
	@layouts.Report("Product Sales", d.ShopName) {
		@rptRangeForm("/admin/reports/product-sales", d.Preset, d.From, d.To) {
			<div class="relative" x-data={ "reportProductPicker('" + strconv.FormatInt(d.ProductID, 10) + "', " + jsArg(d.ProductName) + ")" } x-on:click.away="open=false">
				<label class="block text-xs text-slate-500 mb-1">Product</label>
				<input type="hidden" name="product" x-bind:value="productId"/>
				<input type="text" x-model="name" x-on:input="search()" x-on:focus="search()" placeholder="Search name or barcode…" class="border rounded-lg px-3 py-1.5 w-56"/>
				<div x-show="open && results.length" class="absolute z-20 left-0 mt-1 bg-white border rounded-lg shadow max-h-56 overflow-auto w-64" x-cloak>
					<template x-for="r in results" x-bind:key="r.id">
						<button type="button" x-on:click="choose(r)" class="block w-full text-left px-3 py-1.5 hover:bg-slate-100 text-sm" x-text="r.name + (r.barcode ? '  ·  ' + r.barcode : '')"></button>
					</template>
				</div>
			</div>
			<div>
				<label class="block text-xs text-slate-500 mb-1">Group by</label>
				<select name="group" onchange="this.form.submit()" class="border rounded-lg px-3 py-1.5">
					@statusOpt("day", "Day", d.Group)
					@statusOpt("week", "Week", d.Group)
					@statusOpt("month", "Month", d.Group)
				</select>
			</div>
		}
		@rptPeriodLine(d.From, d.To)
		if d.ProductID == 0 {
			<p class="py-10 text-center text-slate-400">Search for a product above to see its sales over time.</p>
		} else {
			<div class="mb-2 text-lg font-semibold">{ d.ProductName }</div>
			<div class="grid grid-cols-2 gap-4 mb-6">
				@statCard("Units sold (period)", money.Display(d.TotalQty), "indigo")
				@statCard("Revenue (period)", money.Format(d.Symbol, d.TotalRevenue), "emerald")
			</div>
			if len(d.Rows) > 0 || len(d.LastYear) > 0 {
				<div class="mb-6">
					{{ labels, series := productChartData(d.Rows, d.LastYear, d.Group) }}
					@shared.LineChart(labels, series)
				</div>
			} else {
				<p class="py-6 text-center text-slate-400">No sales for this product in the range.</p>
			}
			<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Period</th><th class="py-1.5 text-right">Units</th><th class="py-1.5 text-right">Revenue</th></tr>
			</thead>
			<tbody>
				for _, r := range d.Rows {
					<tr class="border-b last:border-0">
						<td class="py-1.5 font-medium">{ periodLabel(r.Day, d.Group) }</td>
						<td class="py-1.5 text-right">{ money.Display(r.Qty) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.Revenue) }</td>
					</tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr>
					<td class="py-2">Total</td>
					<td class="py-2 text-right">{ money.Display(d.TotalQty) }</td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.TotalRevenue) }</td>
				</tr>
			</tfoot>
		</table>
		}
	}
}


// ============================ Top products ============================

// TopProductRow is one ranked product with the derived display values:
// margin, the in-row bar width (share of the top product's metric) and the
// running cumulative share that drives the Pareto callout.
type TopProductRow struct {
	Rank                  int
	R                     reports.ProductRevenue
	Margin, BarPct, CumPct float64
}

type TopProductsData struct {
	ShopName, Symbol, From, To, Preset, Order, MetricLabel string
	Rows                                                   []TopProductRow
	Count, ParetoN                                         int
	TotalQty, TotalRevenue, TotalProfit                    decimal.Decimal
	OverallMargin                                          float64
}

templ TopProductsReport(d TopProductsData) {
	@layouts.Report("Top Products", d.ShopName) {
		@rptRangeForm("/admin/reports/top-products", d.Preset, d.From, d.To) {
			<div>
				<label class="block text-xs text-slate-500 mb-1">Rank by</label>
				<select name="order" class="border rounded-lg px-3 py-1.5">
					@statusOpt("revenue", "Revenue", d.Order)
					@statusOpt("profit", "Profit", d.Order)
					@statusOpt("qty", "Quantity", d.Order)
				</select>
			</div>
			<a
				class="no-print px-4 py-1.5 rounded-lg border text-sm"
				href={ templ.SafeURL("/admin/reports/top-products?format=csv&order=" + d.Order + "&from=" + d.From + "&to=" + d.To) }
			>Download CSV</a>
		}
		@rptPeriodLine(d.From, d.To)
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
			@kpiCard("Products", strconv.Itoa(d.Count))
			@kpiCard("Revenue", money.Format(d.Symbol, d.TotalRevenue))
			@kpiCard("Profit", money.Format(d.Symbol, d.TotalProfit))
			@kpiCard("Margin", fmtPct1(d.OverallMargin))
		</div>
		if d.ParetoN > 0 && d.ParetoN < d.Count {
			<div class="no-print text-sm text-slate-600 bg-indigo-50 rounded-xl px-4 py-2 mb-4">
				Top <span class="font-semibold">{ strconv.Itoa(d.ParetoN) }</span> of { strconv.Itoa(d.Count) } products make up <span class="font-semibold">80%</span> of { d.MetricLabel } — focus stock &amp; cash there.
			</div>
		}
		<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b">
				<tr>
					<th class="py-1.5 w-8">#</th>
					<th class="py-1.5">Product</th>
					<th class="py-1.5 text-right">Qty sold</th>
					<th class="py-1.5 text-right">Revenue</th>
					<th class="py-1.5 text-right">Margin</th>
					<th class="py-1.5 text-right">Profit</th>
					<th class="py-1.5 text-right">Cum. %</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range d.Rows {
					<tr class="border-b last:border-0">
						<td class="py-1.5 text-slate-400 align-top">{ strconv.Itoa(r.Rank) }</td>
						<td class="py-1.5">
							<a
								class="font-medium text-indigo-700 hover:underline"
								href={ templ.SafeURL("/admin/reports/product-sales?product=" + strconv.FormatInt(r.R.ProductID, 10) + "&from=" + d.From + "&to=" + d.To) }
								title="See this product's trend over time"
							>{ r.R.ProductName }</a>
							<div class="mt-1 h-1.5 rounded bg-indigo-100">
								<div class="h-1.5 rounded bg-indigo-500" style={ barWidth(r.BarPct) }></div>
							</div>
						</td>
						<td class="py-1.5 text-right align-top">{ money.Display(r.R.Qty) }</td>
						<td class="py-1.5 text-right align-top">{ money.Format(d.Symbol, r.R.Revenue) }</td>
						<td class="py-1.5 text-right align-top">
							if r.Margin < 0 {
								<span class="text-rose-600">{ fmtPct1(r.Margin) }</span>
							} else {
								{ fmtPct1(r.Margin) }
							}
						</td>
						<td class="py-1.5 text-right align-top">{ money.Format(d.Symbol, r.R.Profit) }</td>
						<td class="py-1.5 text-right align-top text-slate-500">{ fmtPct1(r.CumPct) }</td>
					</tr>
				}
				if len(d.Rows) == 0 {
					<tr><td colspan="7" class="py-6 text-center text-slate-400">No sales in this period.</td></tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr>
					<td class="py-2" colspan="2">Total (top { strconv.Itoa(len(d.Rows)) })</td>
					<td class="py-2 text-right">{ money.Display(d.TotalQty) }</td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.TotalRevenue) }</td>
					<td class="py-2 text-right">{ fmtPct1(d.OverallMargin) }</td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.TotalProfit) }</td>
					<td class="py-2"></td>
				</tr>
			</tfoot>
		</table>
	}
}

// ============================ Sales by cashier ============================

// CashierRow is one cashier with derived display values: average basket, the
// in-row bar (share of the top earner's net) and share of total net takings.
type CashierRow struct {
	Rank            int
	R               reports.CashierSalesRow
	AvgBasket       decimal.Decimal
	BarPct, SharePct float64
}

type CashierSalesData struct {
	ShopName, Symbol, From, To, Preset string
	Rows                               []CashierRow
	Count                              int
	Gross, Discount, Net, AvgBasket    decimal.Decimal
}

templ CashierSalesReport(d CashierSalesData) {
	@layouts.Report("Sales by Cashier", d.ShopName) {
		@rptRangeForm("/admin/reports/sales-by-cashier", d.Preset, d.From, d.To) {
			<a
				class="no-print px-4 py-1.5 rounded-lg border text-sm"
				href={ templ.SafeURL("/admin/reports/sales-by-cashier?format=csv&from=" + d.From + "&to=" + d.To) }
			>Download CSV</a>
		}
		@rptPeriodLine(d.From, d.To)
		<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
			@kpiCard("Cashiers", strconv.Itoa(len(d.Rows)))
			@kpiCard("Sales", strconv.Itoa(d.Count))
			@kpiCard("Net takings", money.Format(d.Symbol, d.Net))
			@kpiCard("Avg basket", money.Format(d.Symbol, d.AvgBasket))
		</div>
		<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b">
				<tr>
					<th class="py-1.5 w-8">#</th>
					<th class="py-1.5">Cashier</th>
					<th class="py-1.5 text-right">Sales</th>
					<th class="py-1.5 text-right">Avg basket</th>
					<th class="py-1.5 text-right">Discount</th>
					<th class="py-1.5 text-right">Net</th>
					<th class="py-1.5 text-right">Share</th>
				</tr>
			</thead>
			<tbody>
				for _, r := range d.Rows {
					<tr class="border-b last:border-0">
						<td class="py-1.5 text-slate-400 align-top">{ strconv.Itoa(r.Rank) }</td>
						<td class="py-1.5">
							<div class="font-medium">{ r.R.Cashier }</div>
							<div class="mt-1 h-1.5 rounded bg-indigo-100">
								<div class="h-1.5 rounded bg-indigo-500" style={ barWidth(r.BarPct) }></div>
							</div>
						</td>
						<td class="py-1.5 text-right align-top">{ strconv.Itoa(r.R.Count) }</td>
						<td class="py-1.5 text-right align-top">{ money.Format(d.Symbol, r.AvgBasket) }</td>
						<td class="py-1.5 text-right align-top">{ money.Display(r.R.Discount) }</td>
						<td class="py-1.5 text-right align-top">{ money.Format(d.Symbol, r.R.Net) }</td>
						<td class="py-1.5 text-right align-top text-slate-500">{ fmtPct1(r.SharePct) }</td>
					</tr>
				}
				if len(d.Rows) == 0 {
					<tr><td colspan="7" class="py-6 text-center text-slate-400">No sales in this period.</td></tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr>
					<td class="py-2" colspan="2">Total</td>
					<td class="py-2 text-right">{ strconv.Itoa(d.Count) }</td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.AvgBasket) }</td>
					<td class="py-2 text-right">{ money.Display(d.Discount) }</td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.Net) }</td>
					<td class="py-2"></td>
				</tr>
			</tfoot>
		</table>
	}
}

// ============================ Expenses by category ============================

type ExpensesReportData struct {
	ShopName, Symbol, From, To, Preset string
	Rows                               []reports.ExpenseCatRow
	Count                              int
	Total                              decimal.Decimal
}

templ ExpensesReport(d ExpensesReportData) {
	@layouts.Report("Expenses by Category", d.ShopName) {
		@rptRangeForm("/admin/reports/expenses", d.Preset, d.From, d.To) {
			<a
				class="no-print px-4 py-1.5 rounded-lg border text-sm"
				href={ templ.SafeURL("/admin/reports/expenses?format=csv&from=" + d.From + "&to=" + d.To) }
			>Download CSV</a>
		}
		@rptPeriodLine(d.From, d.To)
		<table class="w-full text-sm">
			<thead class="text-left text-slate-500 border-b">
				<tr><th class="py-1.5">Category</th><th class="py-1.5 text-right">Count</th><th class="py-1.5 text-right">Total</th><th class="py-1.5 text-right">Share</th></tr>
			</thead>
			<tbody>
				for _, r := range d.Rows {
					<tr class="border-b last:border-0">
						<td class="py-1.5 font-medium">{ r.Category }</td>
						<td class="py-1.5 text-right">{ strconv.Itoa(r.Count) }</td>
						<td class="py-1.5 text-right">{ money.Format(d.Symbol, r.Total) }</td>
						<td class="py-1.5 text-right text-slate-500">{ pctOf(r.Total, d.Total) }%</td>
					</tr>
				}
				if len(d.Rows) == 0 {
					<tr><td colspan="4" class="py-6 text-center text-slate-400">No expenses in this period.</td></tr>
				}
			</tbody>
			<tfoot class="border-t-2 font-semibold">
				<tr>
					<td class="py-2">Total expenses</td>
					<td class="py-2 text-right">{ strconv.Itoa(d.Count) }</td>
					<td class="py-2 text-right">{ money.Format(d.Symbol, d.Total) }</td>
					<td class="py-2"></td>
				</tr>
			</tfoot>
		</table>
	}
}
