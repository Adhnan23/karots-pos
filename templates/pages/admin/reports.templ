package adminpages

import (
	"strconv"

	"karots-pos/internal/features/categories"
	"karots-pos/internal/features/products"
	"karots-pos/internal/features/suppliers"
	"karots-pos/internal/money"
	adminfragments "karots-pos/templates/fragments/admin"
	"karots-pos/templates/layouts"
)

// ---------------- Low stock / reorder ----------------

type LowStockData struct {
	UserName       string
	Symbol         string
	Rows           []products.Product
	Suppliers      []suppliers.Supplier
	Categories     []categories.TreeNode
	Demand         map[int64]ReorderInfo
	Total          int
	Page, PageSize int
	// Current filter values (echoed back into the filter bar).
	Search       string
	CategoryID   string
	SupplierID   string
	SupplierName string
	// Alternatives (plugin) integration: AltAvailable shows the filter checkbox when
	// a plugin annotates reorder; Alt is the checkbox state; Notes is the per-product
	// alternatives note keyed by product id.
	Alt          bool
	AltAvailable bool
	Notes        map[int64]string
}

templ LowStockPage(d LowStockData) {
	@layouts.Admin("Low Stock", d.UserName, "low-stock") {
		<div class="flex items-center justify-between mb-6">
			<h1 class="text-2xl font-bold">Low Stock / Reorder</h1>
			<a href="/admin/purchases/new" class="text-sm text-slate-500 hover:underline">Manual purchase order →</a>
		</div>
		<div class="bg-white rounded-2xl shadow-sm p-6" x-data={ "poBuilder(" + lowStockConfigJSON(d.Rows, d.Demand, d.Notes) + ")" } x-init="init()">
			@lowStockFilters(d)
			if len(d.Rows) == 0 {
				if d.Search != "" || d.CategoryID != "" || d.SupplierID != "" {
					<p class="py-6 text-center text-slate-500">No low-stock items match these filters. <a href="/admin/reports/low-stock" class="text-indigo-600 hover:underline">Clear filters</a></p>
				} else {
					<p class="py-6 text-center text-slate-500">All products are above their reorder level. 🎉</p>
				}
				@reorderCartBar()
			} else {
				<p class="text-sm text-slate-500 mb-4">Tick the items to reorder, set the quantity and supplier, then build the purchase order(s). Filter by category, supplier or name — your ticks are kept as you search, so you can gather items from several searches into one order. The suggested quantity is demand-based (last 90 days of sales projected over a 2-week lead time).</p>
				<table class="w-full text-sm">
					<thead class="text-left text-slate-500 border-b">
						<tr>
							<th class="py-2 px-3 w-8"><input type="checkbox" x-on:change="toggleAll($event.target.checked)" aria-label="Select all"/></th>
							<th class="py-2 px-3">Product</th>
							<th class="py-2 px-3 text-right">On hand</th>
							<th class="py-2 px-3 text-right">Sold last wk</th>
							<th class="py-2 px-3 text-right">Sold last mo</th>
							<th class="py-2 px-3 text-right">Sold last yr</th>
							<th class="py-2 px-3 w-28 text-right">Order qty</th>
							<th class="py-2 px-3 w-56">Supplier</th>
						</tr>
					</thead>
					<tbody>
						<template x-for="(l, i) in lines" x-bind:key="l.product_id">
							<tr class="border-b last:border-0" x-bind:class="l.selected ? 'bg-indigo-50/50' : ''">
								<td class="py-2 px-3"><input type="checkbox" x-bind:checked="l.selected" x-on:change="l.selected = $event.target.checked; toggleLine(l)"/></td>
								<td class="py-2 px-3 font-medium">
									<span x-text="l.name"></span>
									<template x-if="l.note">
										<span class="block text-xs font-normal text-indigo-500" x-text="l.note"></span>
									</template>
								</td>
								<td class="py-2 px-3 text-right"><span x-text="l.on_hand"></span> <span class="text-slate-400" x-text="l.unit"></span></td>
								<td class="py-2 px-3 text-right text-slate-500" x-text="l.sold_last_week"></td>
								<td class="py-2 px-3 text-right text-slate-500" x-text="l.sold_last_month"></td>
								<td class="py-2 px-3 text-right text-slate-500" x-text="l.sold_last_year"></td>
								<td class="py-2 px-3"><input type="number" step="0.001" min="0" x-model.number="l.suggested" x-on:input="syncLine(l)" class="w-full border rounded px-2 py-1 text-right"/></td>
								<td class="py-2 px-3 relative" x-on:click.away="l._supOpen=false" x-on:keydown.escape="l._supOpen=false">
									<button type="button" x-on:click="l._supOpen=!l._supOpen" class="w-full flex items-center justify-between gap-1 border rounded px-2 py-1 text-left">
										<span class="truncate" x-text="l.supplier_name || 'Select supplier…'" x-bind:class="l.supplier_name ? '' : 'text-slate-400'"></span>
										<span class="text-slate-400 shrink-0">▾</span>
									</button>
									<div x-show="l._supOpen" x-cloak class="absolute z-20 left-0 right-0 mt-1 bg-white border rounded-lg shadow-lg">
										<input x-model="l._supQuery" x-on:input.debounce.200ms="searchLineSuppliers(l)" type="search" placeholder="Search supplier…" class="w-full border-b px-2 py-1.5 text-sm"/>
										<ul class="max-h-48 overflow-auto">
											<template x-for="s in l._supResults" x-bind:key="s.id">
												<li><button type="button" x-on:click="pickLineSupplier(l, s)" class="w-full text-left px-3 py-1.5 text-sm hover:bg-slate-100" x-text="s.name"></button></li>
											</template>
										</ul>
									</div>
								</td>
							</tr>
						</template>
					</tbody>
				</table>
				@reorderCartBar()
				if d.Total > d.PageSize {
					<p class="text-sm text-slate-500 mt-4">
						{ strconv.Itoa(d.Total) } low-stock products match — this page shows { strconv.Itoa(len(d.Rows)) }. Ticks are kept as you page and filter, so gather everything, then build one order.
					</p>
				}
				@rptPager(lowStockQuery(d), d.Page, d.PageSize, d.Total)
			}
		</div>
	}
}

// lowStockFilters is the reorder page's filter bar: live name search plus the
// searchable category and preferred-supplier pickers (same as the product form).
// No Apply button — typing (debounced), picking a category, or picking a supplier
// re-runs the search. Each change reloads the page, but the ticked cart lives in
// localStorage so it survives; the search box re-focuses after the reload. Lives
// inside the poBuilder x-data scope so its Alpine handlers resolve.
templ lowStockFilters(d LowStockData) {
	<form
		method="get"
		action="/admin/reports/low-stock"
		class="flex flex-wrap items-end gap-3 mb-5"
		x-on:category-changed="$el.requestSubmit()"
		x-on:picked="$el.requestSubmit()"
	>
		<div class="flex-1 min-w-48">
			<label class="block text-xs font-medium text-slate-500 mb-1">Search</label>
			<input
				type="search"
				name="search"
				value={ d.Search }
				placeholder="Product name or barcode…"
				class="w-full border rounded-lg px-3 py-2"
				x-on:input.debounce.400ms="$el.form.requestSubmit()"
				x-on:keydown.enter.prevent="$el.form.requestSubmit()"
				x-init="if ($el.value) { $el.focus(); const v = $el.value; $el.value = ''; $el.value = v; }"
			/>
		</div>
		<div class="min-w-56">
			<label class="block text-xs font-medium text-slate-500 mb-1">Category</label>
			@adminfragments.CategoryPicker(d.Categories, "category_id", d.CategoryID, true, "All categories", true, false)
		</div>
		<div class="min-w-56">
			<label class="block text-xs font-medium text-slate-500 mb-1">Preferred supplier</label>
			@adminfragments.SupplierPicker("supplier_id", supFilterID(d.SupplierID), d.SupplierName, "All suppliers", true)
		</div>
		if d.AltAvailable {
			<label class="inline-flex items-center gap-2 text-sm text-slate-600 pb-2">
				<input
					type="checkbox"
					name="alt"
					value="1"
					checked?={ d.Alt }
					x-on:change="$el.form.requestSubmit()"
					class="rounded border-slate-300"
				/>
				Filter by alternatives
			</label>
		}
		if d.Search != "" || d.CategoryID != "" || d.SupplierID != "" {
			<a href="/admin/reports/low-stock" class="px-4 py-2 rounded-lg border text-slate-600">Clear</a>
		}
	</form>
}

// supFilterID parses the supplier filter query value into the id the picker seeds
// with (0 when empty/invalid = "All suppliers").
func supFilterID(s string) int64 {
	id, _ := strconv.ParseInt(s, 10, 64)
	return id
}

// reorderCartBar shows how many items are gathered (across all filters/pages), an
// expandable review of them, and the build button. Bound to the poBuilder scope.
templ reorderCartBar() {
	<div class="border-t mt-4 pt-4">
		<div class="flex items-center justify-between gap-4">
			<button type="button" x-on:click="showCart = !showCart" x-bind:disabled="selectedCount() === 0" class="text-sm text-indigo-600 hover:underline disabled:text-slate-400 disabled:no-underline">
				<span x-text="selectedCount()"></span> item(s) in this order <span x-show="selectedCount() > 0" x-text="showCart ? '▴' : '▾'"></span>
			</button>
			<button type="button" x-on:click="build()" x-bind:disabled="busy || selectedCount() === 0" class="px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-semibold disabled:opacity-40">Build Purchase Order(s)</button>
		</div>
		<div x-show="showCart" x-cloak class="mt-3 border rounded-lg divide-y">
			<template x-for="c in cartItems()" x-bind:key="c.product_id">
				<div class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
					<div class="min-w-0">
						<div class="font-medium truncate" x-text="c.name"></div>
						<div class="text-xs text-slate-500">
							<span x-text="c.qty"></span> <span x-text="c.unit"></span> ·
							<span x-text="c.supplier_name || 'no supplier'" x-bind:class="c.supplier_id ? '' : 'text-rose-500'"></span>
						</div>
					</div>
					<button type="button" x-on:click="removeCartItem(c.product_id)" class="text-slate-400 hover:text-rose-600 shrink-0">✕</button>
				</div>
			</template>
			<div class="px-3 py-2 text-right">
				<button type="button" x-on:click="clearCart()" class="text-xs text-slate-500 hover:text-rose-600">Clear all</button>
			</div>
		</div>
	</div>
}

// suggestedOrder proposes a quantity that brings stock back to roughly twice the
// reorder level (a simple, predictable reorder rule).
func suggestedOrder(p products.Product) string {
	target := decimalFromInt(p.ReorderLevel * 2)
	need := target.Sub(p.StockQty)
	if need.IsNegative() {
		return "0"
	}
	return money.Display(need.Ceil())
}
