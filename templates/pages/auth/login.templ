package authpages

import "karots-pos/templates/layouts"

// LoginPage takes a phone number + PIN. There is no user list (which would leak
// staff) and no admin/cashier toggle — the server routes each user to their home
// by role after the PIN is verified. Plain form POST (no HTMX) so errors
// re-render the whole page with errMsg set.
templ LoginPage(errMsg, installID, serverTime string) {
	@layouts.Base("Login") {
		<!-- The Konami code (↑↑↓↓←→←→ B A) reveals the install id on screen: in
		     kiosk mode DevTools/console/right-click are locked, so the console.info
		     line below is unreachable at the shop. A fixed key sequence can't be hit
		     by a stray click/keypress the way a tap-count could. Not a secret
		     (useless without the master key), just kept off the default screen. -->
		<div
			class="min-h-full flex items-center justify-center p-6"
			x-data="{ reveal: false, seq: ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'], pos: 0, key(e) { const k = e.key.length === 1 ? e.key.toLowerCase() : e.key; if (k === this.seq[this.pos]) { this.pos++; if (this.pos === this.seq.length) { this.reveal = true; this.pos = 0; } } else { this.pos = (k === this.seq[0]) ? 1 : 0; } } }"
			x-on:keydown.window="key($event)"
		>
			<div class="w-full max-w-md bg-white rounded-2xl shadow-sm p-8">
				<h1 class="text-2xl font-bold text-center text-slate-800">Point of Sale</h1>
				<p class="text-center text-slate-500 mt-1">Sign in with your phone number and PIN</p>
				if errMsg != "" {
					<div class="mt-4 rounded-lg bg-red-50 text-red-700 px-4 py-3 text-sm text-center">
						{ errMsg }
					</div>
				}
				<!-- autocomplete is off everywhere: this is a shared counter terminal,
					so the browser must NOT remember or suggest the last phone number
					(that would hand an attacker a valid number, leaving only the PIN to
					guess) nor offer to save the credentials. -->
				<form method="post" action="/login" class="mt-6 space-y-4" autocomplete="off">
					<!-- Phone -->
					<div>
						<label class="block text-sm font-medium text-slate-600 mb-1">Phone number</label>
						<input
							type="tel"
							name="phone"
							inputmode="numeric"
							autocomplete="off"
							autofocus
							required
							placeholder="07XXXXXXXX"
							class="w-full border rounded-lg px-3 py-2.5 text-lg tracking-wide"
						/>
					</div>

					<!-- PIN -->
					<div>
						<label class="block text-sm font-medium text-slate-600 mb-1">PIN</label>
						<input
							type="password"
							name="pin"
							inputmode="numeric"
							pattern="[0-9]*"
							autocomplete="off"
							minlength="4"
							maxlength="6"
							required
							placeholder="••••"
							class="w-full border rounded-lg px-3 py-2.5 text-lg tracking-wide"
						/>
					</div>

					<button
						type="submit"
						class="w-full py-3 rounded-lg bg-indigo-600 text-white font-semibold hover:bg-indigo-700"
					>Sign in</button>
				</form>
				if installID != "" {
					<!-- Logged to the browser console rather than printed on the page: the
					     developer opens devtools to read it, and the shop is not left
					     looking at a code nobody explained. Not a secret either way — it is
					     useless without the master key — so the console is about keeping the
					     login screen clean, not about hiding it. The server time rides along
					     so a shop whose clock is wrong can still be matched: the support PIN
					     is time-based, and the developer computes it for THIS clock. -->
					@installIDConsole(installID, serverTime)
					<div x-show="reveal" x-cloak class="mt-6 pt-4 border-t text-center">
						<div class="text-xs text-slate-400">Install ID</div>
						<div class="text-lg font-mono font-semibold text-slate-700 tracking-wider select-all">{ installID }</div>
						<div class="text-xs text-slate-400 mt-1">{ serverTime }</div>
					</div>
				}
			</div>
		</div>
	}
}

// installIDConsole writes the install id and the server's current time to the
// browser console for support: the id identifies the shop, the time lets the
// developer compute the time-based support PIN for a shop with a wrong clock.
templ installIDConsole(installID, serverTime string) {
	@templ.JSFuncCall("console.info", "POS install "+installID+" · server time "+serverTime)
}
