package layouts

import (
	"karots-pos/internal/features/auth"
	"karots-pos/internal/middleware"
)

// cashierPalette is the command-palette destination list for the terminal. The
// Admin entry is only meaningful for admins/managers, but it's harmless to list.
// Suppliers is gated on the same rule as its routes, so it never offers a
// destination the user would be refused at.
func cashierPalette(role string, canSuppliers bool) []paletteEntry {
	out := []paletteEntry{
		{"/cashier", "Sell", "Terminal"},
		{"/cashier/returns", "Returns", "Terminal"},
		{"/cashier/damage", "Damage", "Terminal"},
		{"/cashier/conversions", "Convert Stock", "Terminal"},
		{"/cashier/credit", "Credit", "Terminal"},
		{"/cashier/receipts", "Receipts", "Terminal"},
		{"/cashier/labels", "Print Labels", "Terminal"},
		{"/cashier/warranty", "Warranty", "Terminal"},
	}
	if middleware.MaySeeSuppliers(role, canSuppliers) {
		out = append(out, paletteEntry{"/cashier/suppliers", "Suppliers", "Terminal"})
		out = append(out, paletteEntry{"/cashier/expenses", "Expenses", "Terminal"})
	}
	for _, t := range pluginCashierTabs() {
		out = append(out, paletteEntry{t.Href, t.Label, "Terminal"})
	}
	if role == auth.RoleAdmin || role == auth.RoleManager {
		out = append(out, paletteEntry{"/admin", "Admin", "Go"})
	}
	return out
}

// Cashier is the terminal shell: a slim topbar with the terminal sections plus a
// full-height work area. `active` highlights the current section; `role` decides
// whether the Admin link is shown (cashiers don't get it); `showChangePin` hides
// the Change PIN link when the shop has disabled cashier PIN changes.
templ Cashier(title, userName, role, active string, showChangePin bool) {
	@Base(title) {
		<div class="h-full flex flex-col">
			<header class="h-14 shrink-0 bg-slate-900 text-white flex items-center justify-between px-5 whitespace-nowrap">
				<div class="flex items-center gap-6">
					<div class="font-bold">POS Terminal</div>
					<nav class="flex items-center gap-1 text-sm">
						@cashierTab("/cashier", "Sell", active == "pos")
						@cashierTab("/cashier/returns", "Returns", active == "returns")
						@cashierTab("/cashier/damage", "Write-off", active == "damage")
						@cashierTab("/cashier/conversions", "Convert", active == "conversions")
						@cashierTab("/cashier/credit", "Credit", active == "credit")
						@cashierTab("/cashier/receipts", "Receipts", active == "receipts")
						@cashierTab("/cashier/labels", "Labels", active == "labels")
						@cashierTab("/cashier/warranty", "Warranty", active == "warranty")
						if middleware.MaySeeSuppliers(role, middleware.CanHandleSuppliersCtx(ctx)) {
							@cashierTab("/cashier/suppliers", "Suppliers", active == "suppliers")
							@cashierTab("/cashier/expenses", "Expenses", active == "expenses")
						}
						for _, t := range pluginCashierTabs() {
							@cashierTab(t.Href, t.Label, active == t.Key)
						}
					</nav>
					<button
						type="button"
						onclick="window.dispatchEvent(new CustomEvent('open-palette'))"
						title="Search / jump (Ctrl+K)"
						class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-slate-300 hover:bg-white/10 hover:text-white text-sm"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
						<kbd class="text-[10px] px-1.5 py-0.5 rounded bg-white/10">⌘K</kbd>
					</button>
				</div>
				<div class="flex items-center gap-4 text-sm">
					@liveClock("text-slate-300 tabular-nums")
					<button type="button" x-data="themeToggle()" x-on:click="toggle()" title="Toggle light / dark" class="text-slate-300 hover:text-white text-base leading-none">
						<span x-text="dark ? '☀️' : '🌙'">🌙</span>
					</button>
					<span class="text-slate-300">{ userName }</span>
					if role == auth.RoleAdmin || role == auth.RoleManager {
						<a href="/admin" class="text-slate-300 hover:text-white">Admin</a>
					}
					if showChangePin {
						<a href="/account/pin" class="text-slate-300 hover:text-white">Change PIN</a>
					}
					<form method="post" action="/lock">
						<button type="submit" title="Lock screen (stays signed in)" class="text-slate-300 hover:text-white">🔒 Lock</button>
					</form>
					<form method="post" action="/logout">
						<button type="submit" class="text-red-300 hover:text-red-200">Log out</button>
					</form>
				</div>
			</header>
			@AutoLockTimer()
			<div class="flex-1 min-h-0">
				{ children... }
			</div>
			@CommandPalette(paletteJSON(cashierPalette(role, middleware.CanHandleSuppliersCtx(ctx))))
		</div>
		@kioskAutoFit()
	}
}

// kioskAutoFit scales the terminal down just enough that its widest row (the top
// nav) fits the screen. Budget POS panels (1366 / 1280 / 1024) are narrower than
// the terminal's natural width, so the nav used to wrap onto two lines and a
// horizontal scrollbar appeared — and the workaround was zooming the browser out
// by hand every shift. This does that automatically. It only ever shrinks (never
// enlarges past 100%), so a full-HD screen is untouched.
templ kioskAutoFit() {
	<script>
	(function () {
	  function fit() {
	    var el = document.documentElement;
	    el.style.zoom = "1"; // measure at natural size, avoids a feedback loop
	    var needed = Math.max(el.scrollWidth, document.body.scrollWidth);
	    var avail = el.clientWidth;
	    var PAD = 16; // leave slack so the edge item (Log out) isn't flush/clipped
	    if (needed + PAD > avail) el.style.zoom = (avail / (needed + PAD)).toFixed(4);
	  }
	  window.addEventListener("load", fit);
	  window.addEventListener("resize", fit);
	  // Menu drill-downs, modals and plugin fragments swap in via HTMX and can
	  // change the widest row, so refit after each settle.
	  document.addEventListener("htmx:afterSettle", fit);
	  // Web-font load shifts text width; refit once it's ready.
	  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
	  fit();
	})();
	</script>
}

templ cashierTab(href, label string, on bool) {
	if on {
		<a href={ templ.SafeURL(href) } class="px-3 py-1.5 rounded-lg bg-white/15 font-medium">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="px-3 py-1.5 rounded-lg text-slate-300 hover:bg-white/10 hover:text-white">{ label }</a>
	}
}
